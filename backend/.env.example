APP_ENV=dev

DATABASE_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_SECONDS=30
DB_BULK_STATEMENT_TIMEOUT_SECONDS=120
DB_LOCK_TIMEOUT_SECONDS=5
DB_IDLE_TRANSACTION_TIMEOUT_SECONDS=60
DB_APPLICATION_NAME=mes-api

AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_FAILURE_WINDOW_MINUTES=10
AUTH_LOGIN_LOCKOUT_MINUTES=3

DRAWING_STORAGE_ROOT=D:\mes_storage\drawings
DRAWING_ALLOWED_EXT=["pdf","png","jpg","jpeg","dwg","dxf"]
DRAWING_MAX_MB=50

DEFECT_PHOTO_STORAGE_ROOT=D:\mes_storage\defect_photos
DEFECT_PHOTO_ALLOWED_EXT=["jpg","jpeg","png","bmp","webp"]
DEFECT_PHOTO_MAX_MB=20

PLATE_DATA_STORAGE_ROOT=D:\mes_storage\plate_data
PLATE_DATA_ALLOWED_EXT=[".pdf",".ai",".eps",".zip",".jpg",".jpeg",".png"]
PLATE_DATA_MAX_MB=100

MES_ADMIN_LOGIN_ID=admin
MES_ADMIN_PASSWORD=

BACKEND_ALLOWED_HOSTS=[]
