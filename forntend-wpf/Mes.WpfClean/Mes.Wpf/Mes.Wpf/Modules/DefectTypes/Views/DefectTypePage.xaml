<UserControl x:Class="Mes.Wpf.Modules.DefectTypes.Views.DefectTypePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Style="{StaticResource CrudSectionCardStyle}">
			<StackPanel>
				<TextBlock Text="검색 조건"
                           Style="{StaticResource CrudSectionTitleStyle}" />

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="220" />
						<ColumnDefinition Width="24" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="검색어"
                                   Style="{StaticResource FormLabelStyle}" />
						<TextBox Style="{StaticResource BaseTextBoxStyle}"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="사용 여부"
                                   Style="{StaticResource FormLabelStyle}" />
						<ComboBox Style="{StaticResource BaseComboBoxStyle}"
                                  ItemsSource="{Binding UseYnOptions}"
                                  SelectedItem="{Binding SelectedUseYn}" />
					</StackPanel>

					<StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
						<Button Content="검색"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding SearchCommand}" />
						<Button Content="초기화"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding ResetCommand}" />
					</StackPanel>
				</Grid>
			</StackPanel>
		</Border>

		<Border Grid.Row="1" Style="{StaticResource CrudSectionCardStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<DockPanel Grid.Row="0" Margin="0,0,0,12">
					<TextBlock Text="목록"
                               Style="{StaticResource CrudSectionTitleStyle}"
                               Margin="0" />
					<TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Text="{Binding Items.Count, StringFormat=총 {0}건}" />
				</DockPanel>

				<DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID"
                                            Binding="{Binding DefectTypeId}"
                                            Width="100" />
						<DataGridTextColumn Header="코드"
                                            Binding="{Binding DefectCode}"
                                            Width="160" />
						<DataGridTextColumn Header="명칭"
                                            Binding="{Binding DefectName}"
                                            Width="*" />
						<DataGridTextColumn Header="메모"
                                            Binding="{Binding Memo}"
                                            Width="240" />
						<DataGridCheckBoxColumn Header="사용"
                                                Binding="{Binding IsActive}"
                                                Width="100" />
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</Border>

		<Border Grid.Row="2" Style="{StaticResource CrudSectionCardStyle}" Margin="0,24,0,0">
			<StackPanel>
				<DockPanel>
					<TextBlock Text="상세 / 등록"
                               Style="{StaticResource CrudSectionTitleStyle}"
                               Margin="0" />
					<StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
						<Button Content="신규"
                                Style="{StaticResource BaseButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding NewCommand}" />
						<Button Content="삭제"
                                Style="{StaticResource BaseButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding DeleteCommand}" />
						<Button Content="저장"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" />
					</StackPanel>
				</DockPanel>

				<Grid Margin="0,12,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="220" />
						<ColumnDefinition Width="24" />
						<ColumnDefinition Width="260" />
						<ColumnDefinition Width="24" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="불량코드"
                                   Style="{StaticResource FormLabelStyle}" />
						<TextBox Style="{StaticResource BaseTextBoxStyle}"
                                 IsEnabled="{Binding IsCodeEditable}"
                                 Text="{Binding EditModel.DefectCode, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="불량명"
                                   Style="{StaticResource FormLabelStyle}" />
						<TextBox Style="{StaticResource BaseTextBoxStyle}"
                                 Text="{Binding EditModel.DefectName, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>

					<StackPanel Grid.Column="4">
						<TextBlock Text="메모"
                                   Style="{StaticResource FormLabelStyle}" />
						<TextBox Style="{StaticResource BaseTextBoxStyle}"
                                 Text="{Binding EditModel.Memo, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
				</Grid>

				<StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
					<TextBlock Text="사용 여부"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
					<CheckBox IsChecked="{Binding EditModel.IsActive}"
                              VerticalAlignment="Center"
                              Content="사용" />
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>