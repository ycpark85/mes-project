<Window x:Class="Mes.Vendor.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보현문화 외주관리 로그인"
        Width="420"
        MinHeight="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="보현문화 외주관리"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="지급받은 계정으로 로그인해 주세요."
                               Margin="0,6,0,0"
                               Foreground="#4B5563" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="아이디" Margin="0,0,0,4" />
                    <TextBox Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="비밀번호" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordInput"
                                 Height="30"
                                 Padding="8,3"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="PasswordInput_OnPasswordChanged" />
                </StackPanel>

                <TextBlock Grid.Row="6"
                           Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           TextWrapping="Wrap" />

                <Button Grid.Row="8"
                        Content="로그인"
                        HorizontalAlignment="Right"
                        Margin="0"
                        MinWidth="96"
                        Command="{Binding LoginCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
