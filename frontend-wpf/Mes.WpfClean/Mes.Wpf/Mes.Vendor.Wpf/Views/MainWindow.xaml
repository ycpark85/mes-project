<Window x:Class="Mes.Vendor.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보현문화 외주관리"
        Width="1660"
        Height="980"
        MinWidth="1400"
        MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Loaded="MainWindow_OnLoaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0B1F33" />
        <SolidColorBrush x:Key="SidebarBackgroundDarkBrush" Color="#071827" />
        <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#0A3A64" />
        <SolidColorBrush x:Key="SidebarHeaderLogoBrush" Color="#0C4C82" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#123A5A" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#D8E6F3" />
        <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#8FA8BF" />

        <Style x:Key="CenterDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CenterDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CenterTextCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SidebarMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="20,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Height="92"
                        Background="{StaticResource SidebarHeaderBrush}"
                        BorderBrush="#1F5C8E"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SidebarHeaderLogoBrush}">
                            <TextBlock Text="SEMI"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="MES"
                                   Foreground="#E5F1FF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom"
                        Padding="16,12"
                        Background="{StaticResource SidebarBackgroundDarkBrush}"
                        BorderBrush="#17344F"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding UserDisplayName}"
                                   Foreground="{StaticResource SidebarMutedTextBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8" />
                        <Button Content="로그아웃"
                                Height="30"
                                MinWidth="0"
                                Margin="0"
                                Background="#334155"
                                Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,18,0,12">
                    <Button Content="보현문화 외주관리"
                            Background="{Binding OutsourceMenuBackground}"
                            Style="{StaticResource SidebarMenuButtonStyle}"
                            Command="{Binding OpenOutsourceManagementCommand}" />
                    <Button Content="보현문화 출고관리"
                            Background="{Binding ShipmentMenuBackground}"
                            Style="{StaticResource SidebarMenuButtonStyle}"
                            Command="{Binding OpenShipmentManagementCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="118" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding HeaderSubtitle}"
                                   Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="#4B5563" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="새창"
                            Width="96"
                            Height="36"
                            Margin="0,10,0,0"
                            Background="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="OpenNewWindowButton_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="16"
                        Margin="0,0,0,12"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="시작일" />
                            <DatePicker Width="156"
                                        MinWidth="156"
                                        SelectedDate="{Binding DateFrom}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="종료일" />
                            <DatePicker Width="156"
                                        MinWidth="156"
                                        SelectedDate="{Binding DateTo}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="공정구분" />
                            <ComboBox Width="120"
                                      ItemsSource="{Binding ProcessTypes}"
                                      SelectedItem="{Binding SelectedProcessType}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0"
                                    Visibility="{Binding StatusFilterVisibility}">
                            <TextBlock Text="상태" />
                            <ComboBox Width="150"
                                      ItemsSource="{Binding Statuses}"
                                      SelectedItem="{Binding SelectedStatus}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="검색어" />
                            <TextBox Width="260"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button Content="조회"
                                Width="80"
                                Height="30"
                                Margin="0,18,8,0"
                                Background="#E5E5E5"
                                Foreground="Black"
                                BorderBrush="#888888"
                                BorderThickness="1"
                                Command="{Binding SearchCommand}" />

                        <Button Content="초기화"
                                Width="80"
                                Height="30"
                                Margin="0,18,8,0"
                                Background="#E5E5E5"
                                Foreground="Black"
                                BorderBrush="#888888"
                                BorderThickness="1"
                                Command="{Binding ResetCommand}" />

                        <Button Content="미리보기"
                                Width="90"
                                Height="30"
                                Margin="0,18,8,0"
                                Background="#E5E5E5"
                                Foreground="Black"
                                BorderBrush="#888888"
                                BorderThickness="1"
                                Visibility="{Binding ShipmentManagementColumnVisibility}"
                                Command="{Binding PrintCommand}" />

                        <Button Content="묶음 출고 처리"
                                Width="130"
                                Height="30"
                                Margin="0,18,0,0"
                                Background="#E5E5E5"
                                Foreground="Black"
                                BorderBrush="#888888"
                                BorderThickness="1"
                                Visibility="{Binding OutsourceManagementColumnVisibility}"
                                Command="{Binding ShipSelectedCommand}" />
                    </WrapPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          CellStyle="{StaticResource CenterDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource CenterDataGridHeaderStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Margin="0,0,0,12"
                          Visibility="{Binding OutsourceManagementColumnVisibility}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="선택" Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="작업지시일자" Width="110" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}" />
                        <DataGridTextColumn Header="작업지시번호" Width="140" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding InstructionNo}" />
                        <DataGridTextColumn Header="공정" Width="80" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding ProcessTypeName}" />
                        <DataGridTextColumn Header="작업구분" Width="80" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding WorkTypeName}" />
                        <DataGridTextColumn Header="입고처" Width="130" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding InboundSourceName}" />
                        <DataGridTextColumn Header="거래처" Width="180" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding PartnerName}" />
                        <DataGridTextColumn Header="품목명" Width="*" MinWidth="220" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding ProductNamesText}" />
                        <DataGridTextColumn Header="발주 시트수" Width="100" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding SheetQty, StringFormat={}{0:N0}}" />
                        <DataGridTextColumn Header="완료 시트수" Width="100" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding WorkDoneSheetQty, StringFormat={}{0:N0}}" />
                        <DataGridTextColumn Header="상태" Width="100" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding StatusName}" />

                        <DataGridTemplateColumn Header="입고완료" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="입고완료"
                                            Height="26"
                                            MinWidth="76"
                                            Margin="0"
                                            Background="#E5E5E5"
                                            Foreground="Black"
                                            BorderBrush="#888888"
                                            BorderThickness="1"
                                            IsEnabled="{Binding CanInbound}"
                                            Command="{Binding DataContext.InboundCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="작업완료" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="작업완료"
                                            Height="26"
                                            MinWidth="76"
                                            Margin="0"
                                            Background="#E5E5E5"
                                            Foreground="Black"
                                            BorderBrush="#888888"
                                            BorderThickness="1"
                                            IsEnabled="{Binding CanWorkDone}"
                                            Command="{Binding DataContext.WorkDoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          CellStyle="{StaticResource CenterDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource CenterDataGridHeaderStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Margin="0,0,0,12"
                          Visibility="{Binding ShipmentManagementColumnVisibility}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="작업지시일자" Width="110" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}" />
                        <DataGridTextColumn Header="작업지시번호" Width="140" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding InstructionNo}" />
                        <DataGridTextColumn Header="공정" Width="80" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding ProcessTypeName}" />
                        <DataGridTextColumn Header="작업구분" Width="80" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding WorkTypeName}" />
                        <DataGridTextColumn Header="거래처명" Width="180" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding PartnerName}" />
                        <DataGridTextColumn Header="품목명" Width="*" MinWidth="260" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding ProductNamesText}" />
                        <DataGridTextColumn Header="발주 시트수" Width="100" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding SheetQty, StringFormat={}{0:N0}}" />
                        <DataGridTextColumn Header="완료 시트수" Width="100" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding WorkDoneSheetQty, StringFormat={}{0:N0}}" />
                        <DataGridTextColumn Header="외주가공비" Width="120" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding OutsourceProcessingFee, StringFormat={}{0:N0}}" />
                        <DataGridTextColumn Header="출고일시" Width="150" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding ShippedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                        <DataGridTextColumn Header="비고" Width="120" ElementStyle="{StaticResource CenterTextCellStyle}" Binding="{Binding WorkDoneRemark}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        Padding="14"
                        Margin="0,0,0,12"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding TotalCount, StringFormat=검색 건수: {0:N0}건}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="16,0,0,0">
                            <Button Content="이전"
                                    Width="60"
                                    Height="30"
                                    Command="{Binding PreviousPageCommand}" />
                            <TextBlock Margin="12,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding PageDisplayText}" />
                            <Button Content="다음"
                                    Width="60"
                                    Height="30"
                                    Command="{Binding NextPageCommand}" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding TotalOutsourceProcessingFee, StringFormat=외주가공비 합계: {0:N0}}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#1D4ED8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="3"
                        MinHeight="132"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid DataContext="{Binding SelectedItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="선택 상세" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding InstructionNo, StringFormat=작업지시번호: {0}}" />
                            <TextBlock Text="{Binding InstructionDate, StringFormat=작업지시일자: {0:yyyy-MM-dd}}" />
                            <TextBlock Text="{Binding ProcessTypeName, StringFormat=공정: {0}}" />
                            <TextBlock Text="{Binding WorkTypeName, StringFormat=작업구분: {0}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding InboundSourceName, StringFormat=입고처: {0}}" Visibility="{Binding DataContext.OutsourceManagementColumnVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="{Binding PartnerName, StringFormat=거래처명: {0}}" />
                            <TextBlock Text="{Binding ProductNamesText, StringFormat=품목명: {0}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding SheetQty, StringFormat=발주 시트수: {0:N0}}" />
                            <TextBlock Text="{Binding WorkDoneSheetQty, StringFormat=완료 시트수: {0:N0}}" />
                            <TextBlock Text="{Binding SheetCutCount, StringFormat=시트 컷수: {0:N0}}" />
                            <TextBlock Text="{Binding OutsourceProcessingFee, StringFormat=외주가공비: {0:N0}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding StatusName, StringFormat=상태: {0}}" Visibility="{Binding DataContext.OutsourceManagementColumnVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="{Binding VendorReceivedAt, StringFormat=입고완료: {0:yyyy-MM-dd HH:mm}}" />
                            <TextBlock Text="{Binding WorkDoneAt, StringFormat=작업완료: {0:yyyy-MM-dd HH:mm}}" />
                            <TextBlock Text="{Binding ShippedAt, StringFormat=출고일시: {0:yyyy-MM-dd HH:mm}}" />
                            <TextBlock Text="{Binding WorkDoneRemark, StringFormat=비고: {0}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
