<Window x:Class="Mes.Vendor.Wpf.Views.WorkDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보현문화 작업완료"
        Width="560"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="보현문화 작업완료"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,16" />

            <TextBlock Text="거래처" />
            <TextBox Text="{Binding PartnerName, Mode=OneWay}"
                     IsReadOnly="True"
                     Margin="0,0,0,10" />

            <TextBlock Text="작업구분" />
            <TextBox Text="{Binding WorkTypeName, Mode=OneWay}"
                     IsReadOnly="True"
                     Margin="0,0,0,10" />

            <TextBlock Text="LOT" />
            <TextBox Text="{Binding LotNosText, Mode=OneWay}"
                     IsReadOnly="True"
                     Margin="0,0,0,10" />

            <TextBlock Text="품목명" />
            <TextBox Text="{Binding ProductNamesText, Mode=OneWay}"
                     IsReadOnly="True"
                     Margin="0,0,0,10" />

            <TextBlock Text="발주 시트수" />
            <TextBox Text="{Binding SheetQty, Mode=OneWay, StringFormat={}{0:N0}}"
                     IsReadOnly="True"
                     Margin="0,0,0,10" />

            <TextBlock Text="완료 시트수" />
            <TextBox Text="{Binding WorkDoneSheetQtyText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" />

            <TextBlock Text="외주가공비" />
            <TextBox Text="{Binding OutsourceProcessingFeeText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" />

            <TextBlock Text="비고" />
            <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="저장"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" />

            <Button Content="취소"
                    Width="90"
                    Height="32"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
