<Window x:Class="Mes.Wpf.Modules.Auth.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES 로그인"
        Width="980"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Border Margin="24"
            Background="White"
            CornerRadius="24"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="24,0,0,24"
                    Background="#0F172A"
                    Padding="44">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,48">
                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="16"
                                    Background="#1D4ED8">
                                <TextBlock Text="MES"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="MES System"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="Bold" />
                                <TextBlock Text="Manufacturing Execution System"
                                           Foreground="#CBD5E1"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="생산 현장을 위한&#x0a;통합 관리 시스템"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   LineHeight="46" />

                        <TextBlock Margin="0,24,0,0"
                                   Width="410"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   Foreground="#CBD5E1"
                                   FontSize="15"
                                   LineHeight="25"
                                   Text="로그인 후 권한에 따라 사용 가능한 메뉴만 표시됩니다. 사용자별 역할과 버튼 권한을 기반으로 안전하게 운영합니다." />
                    </StackPanel>

                    <UniformGrid Grid.Row="1"
                                 Columns="3"
                                 Margin="0,24,0,0">
                        <Border Margin="0,0,8,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="#1E293B">
                            <StackPanel>
                                <TextBlock Text="권한"
                                           Foreground="#94A3B8"
                                           FontSize="12" />
                                <TextBlock Text="Menu"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Margin="4,0,4,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="#1E293B">
                            <StackPanel>
                                <TextBlock Text="제어"
                                           Foreground="#94A3B8"
                                           FontSize="12" />
                                <TextBlock Text="Button"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Margin="8,0,0,0"
                                Padding="14"
                                CornerRadius="16"
                                Background="#1E293B">
                            <StackPanel>
                                <TextBlock Text="보안"
                                           Foreground="#94A3B8"
                                           FontSize="12" />
                                <TextBlock Text="Token"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#F8FAFC"
                    CornerRadius="0,24,24,0"
                    Padding="46">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,18">
                            <TextBlock Text="권한 기반 로그인"
                                       Foreground="#1D4ED8"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="로그인"
                                   Foreground="#0F172A"
                                   FontSize="32"
                                   FontWeight="Bold" />

                        <TextBlock Text="아이디와 비밀번호를 입력하세요."
                                   Foreground="#64748B"
                                   FontSize="14"
                                   Margin="0,8,0,32" />

                        <TextBlock Text="아이디"
                                   Foreground="#334155"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Border Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="16"
                                Height="48"
                                Margin="0,0,0,18">
                            <TextBox Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     Padding="16,0"
                                     TabIndex="0" />
                        </Border>

                        <TextBlock Text="비밀번호"
                                   Foreground="#334155"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Border Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="16"
                                Height="48"
                                Margin="0,0,0,8">
                            <PasswordBox x:Name="PasswordBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="15"
                                         VerticalContentAlignment="Center"
                                         Padding="16,0"
                                         TabIndex="1"
                                         KeyDown="PasswordBox_KeyDown" />
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   FontSize="13"
                                   Height="24"
                                   Margin="0,0,0,10" />

                        <Button Content="로그인"
                                Height="48"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                TabIndex="2"
                                Click="LoginButton_Click" />

                        <Grid Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="기본 관리자: admin"
                                       Foreground="#94A3B8"
                                       FontSize="12" />

                            <TextBlock Grid.Column="1"
                                       Text="MES v0.1.0"
                                       Foreground="#94A3B8"
                                       FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>