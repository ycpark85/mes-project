<Window x:Class="Mes.Wpf.Modules.BohyunOutsourceManagement.Views.BohyunOutsourceShipmentPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보현문화 출고리스트 출력 미리보기"
        Width="1100"
        Height="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="출력"
                        Width="90"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="Print_Click"/>

                <Button Content="닫기"
                        Width="90"
                        Height="32"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>

        <FlowDocumentReader x:Name="PreviewDocumentReader"
                            Grid.Row="1"
                            ViewingMode="Page"
                            IsFindEnabled="True"/>
    </Grid>
</Window>