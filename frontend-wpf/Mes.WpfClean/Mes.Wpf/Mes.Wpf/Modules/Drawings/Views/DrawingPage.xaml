<UserControl x:Class="Mes.Wpf.Modules.Drawings.Views.DrawingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2.4*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.8*"/>
        </Grid.RowDefinitions>

        <!-- 검색 영역 -->
        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="도면번호"/>

                <TextBox Grid.Column="1"
                         Margin="4,0,12,0"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="사용여부"/>

                <ComboBox Grid.Column="3"
                          Margin="4,0,12,0"
                          ItemsSource="{Binding UseYnOptions}"
                          SelectedItem="{Binding SelectedUseYn}"/>

                <Button Grid.Column="5"
                        Margin="4,0,0,0"
                        Content="조회"
                        Command="{Binding SearchCommand}"/>

                <Button Grid.Column="6"
                        Margin="4,0,0,0"
                        Content="초기화"
                        Command="{Binding ResetCommand}"/>

                <Button Grid.Column="7"
                        Margin="4,0,0,0"
                        Content="신규"
                        Command="{Binding NewCommand}"/>
            </Grid>
        </Border>

        <!-- 도면 목록 -->
        <DataGrid Grid.Row="1"
                  Margin="0,0,0,12"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding DrawingId}"
                                    Width="80"/>
                <DataGridTextColumn Header="도면번호"
                                    Binding="{Binding DrawingNo}"
                                    Width="220"/>
                <DataGridTextColumn Header="현재 Revision ID"
                                    Binding="{Binding CurrentRevisionId}"
                                    Width="140"/>
                <DataGridCheckBoxColumn Header="사용"
                                        Binding="{Binding IsActive}"
                                        Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 도면 상세 -->
        <Border Grid.Row="2"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="도면번호"/>

                <TextBox Grid.Column="1"
                         Margin="4,0,12,0"
                         Text="{Binding EditModel.DrawingNo, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="사용"/>

                <CheckBox Grid.Column="3"
                          VerticalAlignment="Center"
                          IsChecked="{Binding EditModel.IsActive}"/>

                <Button Grid.Column="5"
                        Margin="4,0,0,0"
                        Content="저장"
                        Command="{Binding SaveCommand}"/>

                <Button Grid.Column="6"
                        Margin="4,0,0,0"
                        Content="삭제"
                        Command="{Binding DeleteCommand}"/>
            </Grid>
        </Border>

        <!-- 리비전 영역 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 리비전 입력 -->
            <Border Grid.Column="0"
                    Padding="12"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid IsEnabled="{Binding CanCreateRevision}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Revision"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             MinWidth="220"
                             Margin="4,0,0,8"
                             Text="{Binding RevisionEditModel.RevNo, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="현재지정"/>

                    <CheckBox Grid.Row="1"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="4,0,0,8"
                              IsChecked="{Binding RevisionEditModel.SetAsCurrent}"/>

                    <Grid Grid.Row="2"
                          Grid.Column="1"
                          Margin="4,0,0,0"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Width="80"
                                Content="신규"
                                Command="{Binding NewRevisionCommand}"/>

                        <Button Grid.Column="2"
                                Width="110"
                                Content="리비전생성"
                                Command="{Binding CreateRevisionCommand}"/>

                        <Button Grid.Column="4"
                                Width="90"
                                Content="현재지정"
                                Command="{Binding SetCurrentRevisionCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 리비전 목록 -->
            <DataGrid Grid.Column="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding RevisionItems}"
                      SelectedItem="{Binding SelectedRevision, Mode=TwoWay}"
                      IsEnabled="{Binding IsRevisionSectionEnabled}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Revision ID"
                                        Binding="{Binding RevisionId}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Rev No"
                                        Binding="{Binding RevNo}"
                                        Width="120"/>
                    <DataGridTextColumn Header="파일수"
                                        Binding="{Binding Files.Count}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 파일 관리 -->
        <Border Grid.Row="5"
                MinHeight="165"
                Padding="12"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="6">
            <Grid IsEnabled="{Binding CanManageRevisionFiles}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 도면 파일 -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="도면파일"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="4,0,8,8"
                         IsReadOnly="True"
                         Text="{Binding DrawingDisplayFileName, Mode=OneWay}"
                         ToolTip="{Binding DrawingDisplayFileName, Mode=OneWay}"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,8,8"
                        Content="선택"
                        Command="{Binding BrowseDrawingFileCommand}"/>

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Margin="0,0,8,8"
                        Content="업로드"
                        Command="{Binding UploadDrawingFileCommand}"/>

                <Button Grid.Row="0"
                        Grid.Column="4"
                        Margin="0,0,8,8"
                        Content="교체"
                        Command="{Binding ReplaceDrawingFileCommand}"/>

                <Button Grid.Row="0"
                        Grid.Column="5"
                        Margin="0,0,8,8"
                        Content="열기"
                        Command="{Binding OpenDrawingFileCommand}"/>

                <!-- 원본 파일 -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="원본파일"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="4,0,8,8"
                         IsReadOnly="True"
                         Text="{Binding OriginalDisplayFileName, Mode=OneWay}"
                         ToolTip="{Binding OriginalDisplayFileName, Mode=OneWay}"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,8,8"
                        Content="선택"
                        Command="{Binding BrowseOriginalFileCommand}"/>

                <Button Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,0,8,8"
                        Content="업로드"
                        Command="{Binding UploadOriginalFileCommand}"/>

                <Button Grid.Row="1"
                        Grid.Column="4"
                        Margin="0,0,8,8"
                        Content="교체"
                        Command="{Binding ReplaceOriginalFileCommand}"/>

                <Button Grid.Row="1"
                        Grid.Column="5"
                        Margin="0,0,8,8"
                        Content="열기"
                        Command="{Binding OpenOriginalFileCommand}"/>

                <!-- 판작업 파일 -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="판작업"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Margin="4,0,8,0"
                         IsReadOnly="True"
                         Text="{Binding PlateDisplayFileName, Mode=OneWay}"
                         ToolTip="{Binding PlateDisplayFileName, Mode=OneWay}"/>

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        Content="선택"
                        Command="{Binding BrowsePlateFileCommand}"/>

                <Button Grid.Row="2"
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        Content="업로드"
                        Command="{Binding UploadPlateFileCommand}"/>

                <Button Grid.Row="2"
                        Grid.Column="4"
                        Margin="0,0,8,0"
                        Content="교체"
                        Command="{Binding ReplacePlateFileCommand}"/>

                <Button Grid.Row="2"
                        Grid.Column="5"
                        Margin="0,0,8,0"
                        Content="열기"
                        Command="{Binding OpenPlateFileCommand}"/>
            </Grid>
        </Border>

        <!-- 로딩 오버레이 -->
        <Border Background="#66000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="240"
                    Padding="16"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <ProgressBar Height="16"
                                 IsIndeterminate="True"
                                 Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>