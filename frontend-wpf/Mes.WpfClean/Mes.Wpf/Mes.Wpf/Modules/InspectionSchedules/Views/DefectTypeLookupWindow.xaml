<Window x:Class="Mes.Wpf.Modules.InspectionSchedules.Views.DefectTypeLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="불량유형 검색"
        Width="980"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 검색 영역 -->
        <Border Grid.Row="0"
                Padding="12"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="검색어"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="KeywordTextBox_KeyDown"/>

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Text="사용여부"
                           FontWeight="SemiBold"/>

                <ComboBox Grid.Column="4"
                          Height="30"
                          ItemsSource="{Binding UseYnOptions}"
                          SelectedItem="{Binding SelectedUseYn}" />

                <Button Grid.Column="6"
                        Height="30"
                        Content="조회"
                        Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <!-- 목록 -->
        <Border Grid.Row="2"
                Padding="8"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="불량유형ID"
                                        Binding="{Binding DefectTypeId}"
                                        Width="110"/>

                    <DataGridTextColumn Header="불량코드"
                                        Binding="{Binding DefectCode}"
                                        Width="140"/>

                    <DataGridTextColumn Header="1차카테고리"
                                        Binding="{Binding Category1Name}"
                                        Width="170"/>   

                    <DataGridTextColumn Header="2차카테고리"
                                        Binding="{Binding Category2Name}"
                                        Width="200"/>       

                    <DataGridTextColumn Header="메모"
                                        Binding="{Binding Memo}"
                                        Width="*"/>

                    <DataGridTextColumn Header="사용여부"
                                        Binding="{Binding IsActive}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="선택"
                    Click="SelectButton_Click"/>
            <Button Width="100"
                    Height="32"
                    Content="닫기"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>