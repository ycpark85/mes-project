<Window x:Class="Mes.Wpf.Modules.InspectionSchedules.Views.InspectionLabelPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검수 라벨 인쇄"
        Width="430"
        Height="410"
        MinHeight="410"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Window.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="검수 라벨 인쇄"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#111827"/>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="제품명" Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="ProductNameTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="규격" Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="ProductSpecTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="LOT" Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="LotNoTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="수량" Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="QtyTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         Style="{StaticResource InputTextBoxStyle}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="인쇄매수" Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="CopiesTextBox"
                         Grid.Row="8"
                         Grid.Column="1"
                         Style="{StaticResource InputTextBoxStyle}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="인쇄"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#1F73E8"
                    BorderBrush="#1A67D1"
                    Foreground="White"
                    Click="PrintButton_Click"/>
            <Button Content="닫기"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#F8F9FB"
                    BorderBrush="#C7CED8"
                    Foreground="#374151"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
