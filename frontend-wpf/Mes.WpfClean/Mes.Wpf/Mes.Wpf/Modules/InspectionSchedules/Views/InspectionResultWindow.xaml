<Window x:Class="Mes.Wpf.Modules.InspectionSchedules.Views.InspectionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="검수 실적 등록"
        Width="1120"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단: 정보섹션 + 누적섹션 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1.3*"/>
                
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="LOT 번호" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,16,10" VerticalAlignment="Center" Text="{Binding LotNo}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,10" VerticalAlignment="Center" Text="거래처" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,0,10" VerticalAlignment="Center" Text="{Binding PartnerName}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="품목명" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,16,10" VerticalAlignment="Center" Text="{Binding ProductName}"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,8,10" VerticalAlignment="Center" Text="검수일자" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" VerticalAlignment="Center" Text="{Binding InspectionDate, StringFormat=yyyy-MM-dd}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="LOT 계획수량" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,16,10" VerticalAlignment="Center"  Text="{Binding PlanQty, StringFormat={}{0:N0}}"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="납기일자" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,0,10" VerticalAlignment="Center" Text="{Binding DueDate, StringFormat=yyyy-MM-dd}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="발주수량" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,16,10" VerticalAlignment="Center" Text="{Binding OrderQty, StringFormat={}{0:N0}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" Text="누적 양품수량" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" HorizontalAlignment="Right" Text="{Binding AccumulatedGoodQty,StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#1F57B7"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" Text="누적 불량수량" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" HorizontalAlignment="Right" Text="{Binding AccumulatedDefectQty,StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#1F57B7"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" Text="누적 불량출고수량" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding AccumulatedDefectShipQty,StringFormat={}{0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#1F57B7"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 기록섹션 -->
        <Border Grid.Row="1"
        Margin="0,16,0,12"
        Padding="12"
        BorderBrush="#D9DEE7"
        BorderThickness="1"
        CornerRadius="4"
        Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="양품수량"
                   FontWeight="SemiBold"/>
                <TextBox Grid.Column="1"
                 Margin="8,0,16,0"
                 Text="{Binding GoodQty, UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   Text="불량수량"
                   FontWeight="SemiBold"/>
                <TextBox Grid.Column="3"
                 Margin="8,0,16,0"
                 Text="{Binding DefectQty, UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                   VerticalAlignment="Center"
                   Text="불량출고수량"
                   FontWeight="SemiBold"/>
                <TextBox Grid.Column="5"
                 Margin="8,0,16,0"
                 Text="{Binding DefectShipQty, UpdateSourceTrigger=PropertyChanged}"  VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6"
                   VerticalAlignment="Center"
                   Text="검수수량"
                   FontWeight="SemiBold"/>
                <Border Grid.Column="7"
                Margin="8,0,0,0"
                Padding="8,4"
                Background="#F5F7FA"
                BorderBrush="#D9DEE7"
                BorderThickness="1">
                    <TextBlock Text="{Binding TotalQty, StringFormat={}{0:N0}}"
                       VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 불량내역 -->
        <GroupBox Grid.Row="2" Header="불량내역 작성">
            <DockPanel Margin="8">
                <Button DockPanel.Dock="Top"
                        Width="90"
                        Height="28"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Content="행 추가"
                        Command="{Binding AddDefectCommand}" />

                <DataGrid ItemsSource="{Binding Defects}"
                          SelectedItem="{Binding SelectedDefect}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="불량유형ID"
                                            Binding="{Binding DefectTypeId, UpdateSourceTrigger=PropertyChanged}"
                                            Width="120"/>
                        <DataGridTextColumn Header="불량유형명"
                                            Binding="{Binding DefectTypeName, UpdateSourceTrigger=PropertyChanged}"
                                            Width="180"/>
                        <DataGridTextColumn Header="비고"
                                            Binding="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>

                        <DataGridTemplateColumn Header="불량사진" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <TextBlock Width="150"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding FileName}" />
                                                    <Button Width="50"
                                                            Height="22"
                                                            Margin="6,0,0,0"
                                                            Content="삭제"
                                                            Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="작업" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60"
                                                Height="24"
                                                Margin="0,0,6,0"
                                                Content="사진추가"
                                                Command="{Binding DataContext.UploadPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Width="50"
                                                Height="24"
                                                Content="삭제"
                                                Command="{Binding DataContext.RemoveDefectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- 분할검수 -->
        <Border Grid.Row="3"
                Margin="0,12,0,12"
                Padding="12"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          VerticalAlignment="Center"
                          Content="분할검수"
                          IsChecked="{Binding IsPartial}" />

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="다음 검수일자" FontWeight="SemiBold"/>
                <DatePicker Grid.Column="3"
                            Margin="8,0,16,0"
                            SelectedDate="{Binding NextInspectionDate}"
                            IsEnabled="{Binding IsPartial}" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="사유/메모" FontWeight="SemiBold"/>
                <TextBox Grid.Column="5"
                         Margin="8,0,0,0"
                         Text="{Binding PartialReason, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsPartial}" />
            </Grid>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100" Height="32" Margin="0,0,8,0" Content="저장" Command="{Binding SaveCommand}" />
            <Button Width="100" Height="32" Content="취소" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>