<Window x:Class="Mes.Wpf.Modules.InspectionSchedules.Views.InspectionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="검수 실적 등록"
        Width="1240"
        Height="820"
        MinWidth="1120"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단: 기본정보 + 누적섹션 + 출고/재고 예상 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- 기본정보 -->
            <Border Grid.Column="0"
                    Padding="12"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,8,10"
                               VerticalAlignment="Center"
                               Text="LOT 번호"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,16,10"
                               VerticalAlignment="Center"
                               Text="{Binding LotNo}"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Margin="0,0,8,10"
                               VerticalAlignment="Center"
                               Text="거래처"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="3"
                               Margin="0,0,0,10"
                               VerticalAlignment="Center"
                               Text="{Binding PartnerName}"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,8,10"
                               VerticalAlignment="Center"
                               Text="품목명"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,0,16,10"
                               VerticalAlignment="Center"
                               Text="{Binding ProductName}"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Margin="0,0,8,10"
                               VerticalAlignment="Center"
                               Text="검수일자"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="3"
                               Margin="0,0,0,10"
                               VerticalAlignment="Center"
                               Text="{Binding InspectionDate, StringFormat=yyyy-MM-dd}"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,0,8,10"
                               VerticalAlignment="Center"
                               Text="LOT 계획수량"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,0,16,10"
                               VerticalAlignment="Center"
                               Text="{Binding PlanQty, StringFormat={}{0:N0}}"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Margin="0,0,8,10"
                               VerticalAlignment="Center"
                               Text="납기일자"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="3"
                               Margin="0,0,0,10"
                               VerticalAlignment="Center"
                               Text="{Binding DueDate, StringFormat=yyyy-MM-dd}"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="발주수량"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Text="{Binding OrderQty, StringFormat={}{0:N0}}"/>
                </Grid>
            </Border>

            <!-- 누적수량 -->
            <Border Grid.Column="2"
                    Padding="12"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White">
                <StackPanel>
                    <TextBlock Text="누적 검수 현황"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="누적 양품수량"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AccumulatedGoodQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F5FBF"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="누적 불량수량"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AccumulatedDefectQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F5FBF"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="누적 불량출고수량"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AccumulatedDefectShipQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F5FBF"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="누적 검수수량"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AccumulatedInspectedQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F5FBF"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 출고 / 재고 예상 -->
            <Border Grid.Column="4"
                    Padding="12"
                    BorderBrush="#BFD3F2"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="#F8FBFF">
                <StackPanel>
                    <TextBlock Text="출고 / 재고 예상"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="현재고"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentStockQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#1F5FBF"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="출고목표수량"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ShipTargetQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="기출고수량"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AlreadyShippedQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="남은 출고필요"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding RemainingShipTargetQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   Foreground="#C76300"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="이번 출고가능"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SellableQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"/>
                    </Grid>

                    <Border Margin="0,0,0,10"
                            Padding="8"
                            Background="White"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="현재고 + 양품/불량출고 - 출고예정 = 예상재고"
                                       Foreground="#666666"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="가용수량"
                                               HorizontalAlignment="Center"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding AvailableQty, StringFormat={}{0:N0}}"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="#1F5FBF"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="-"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="출고예정"
                                               HorizontalAlignment="Center"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding ExpectedShipQty, StringFormat={}{0:N0}}"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="#C76300"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="="
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"/>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="예상재고"
                                               HorizontalAlignment="Center"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding ExpectedStockQty, StringFormat={}{0:N0}}"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="#1F5FBF"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="부족수량"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ShortageQty, StringFormat={}{0:N0}}"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   Foreground="#C62828"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 검수 실적 입력 -->
        <Border Grid.Row="1"
                Margin="0,16,0,12"
                Padding="12"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="양품수량"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                         Margin="8,0,16,0"
                         Text="{Binding GoodQty, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                         VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="불량수량"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="3"
                         Margin="8,0,16,0"
                         Text="{Binding DefectQty, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                         VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Text="불량출고수량"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="5"
                         Margin="8,0,16,0"
                         Text="{Binding DefectShipQty, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                         VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6"
                           VerticalAlignment="Center"
                           Text="검수수량"
                           FontWeight="SemiBold"/>

                <Border Grid.Column="7"
                        Margin="8,0,0,0"
                        Padding="8,4"
                        Background="#F5F7FA"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1">
                    <TextBlock Text="{Binding TotalQty, StringFormat={}{0:N0}}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 불량내역 -->
        <GroupBox Grid.Row="2"
                  Header="불량내역 작성">
            <DockPanel Margin="8">
                <Button DockPanel.Dock="Top"
                        Width="90"
                        Height="28"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Content="행 추가"
                        Command="{Binding AddDefectCommand}"/>

                <DataGrid ItemsSource="{Binding Defects}"
                          SelectedItem="{Binding SelectedDefect}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="불량유형ID"
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DefectTypeId, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             KeyDown="DefectTypeIdTextBox_KeyDown"
                                             Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="불량유형명"
                                            Binding="{Binding DefectTypeName}"
                                            Width="180"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="메모"
                                            Binding="{Binding DefectTypeMemo}"
                                            Width="220"
                                            IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="불량사진"
                                                Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,2,0,2">
                                                    <TextBlock Width="150"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding FileName}"/>

                                                    <Button Width="50"
                                                            Height="22"
                                                            Margin="6,0,0,0"
                                                            Content="삭제"
                                                            Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="작업"
                                                Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="60"
                                                Height="24"
                                                Margin="0,0,6,0"
                                                Content="사진추가"
                                                Command="{Binding DataContext.UploadPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Width="50"
                                                Height="24"
                                                Content="삭제"
                                                Command="{Binding DataContext.RemoveDefectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- 특이사항 -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">     
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="특이사항"
                           VerticalAlignment="Top"
                           Margin="0,4,8,0"
                           FontWeight="SemiBold"/>      

                <TextBox Grid.Column="1"
                         Height="64"
                         Padding="8,6"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>       
            </Grid>
        </Border>

        <!-- 분할검수 -->
        <Border Grid.Row="4"
                Margin="0,12,0,12"
                Padding="12"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          VerticalAlignment="Center"
                          Content="분할검수"
                          IsChecked="{Binding IsPartial}"/>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="다음 검수일자"
                           FontWeight="SemiBold"/>

                <DatePicker Grid.Column="3"
                            Margin="8,0,16,0"
                            SelectedDate="{Binding NextInspectionDate}"
                            IsEnabled="{Binding IsPartial}"/>

                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Text="사유/메모"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="5"
                         Margin="8,0,0,0"
                         Text="{Binding PartialReason, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsPartial}"/>
            </Grid>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="저장"
                    Command="{Binding SaveCommand}"/>

            <Button Width="100"
                    Height="32"
                    Content="취소"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>