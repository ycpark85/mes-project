<Window x:Class="Mes.Wpf.Modules.InspectionSchedules.Views.InspectionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검수실적등록"
        Width="1180"
        Height="820"
        MinWidth="1050"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">

    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SubSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 기본 정보 / 출고 목표 요약 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- 기본 정보 -->
                <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="기본 정보"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="LOT 번호"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding LotNo}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="품목명"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ProductName}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="거래처"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding PartnerName}"/>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="검수일자"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding InspectionDate, StringFormat=yyyy-MM-dd}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 수량 / 납기 정보 -->
                <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="수량 / 납기 정보"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="수주수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding OrderQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="계획수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding PlanQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="납기일"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding DueDate, StringFormat=yyyy-MM-dd}"/>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="검수수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding TotalQty, StringFormat={}{0:N0}}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 출하대기 / 재고 요약 -->
                <Border Grid.Column="4" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="출하대기 / 재고 요약"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="현재고수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CurrentStockQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="출고목표수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ShipTargetQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="기출하수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AlreadyShippedQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="남은출고목표"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding RemainingShipTargetQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="출하대기합계"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ExpectedShipQty, StringFormat={}{0:N0}}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 검수 수량 / 출하대기 입력 -->
            <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="검수수량 및 출하대기 수량"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 검수 결과 수량 -->
                        <Border Grid.Column="0" Style="{StaticResource SubSectionBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="검수 결과"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="양품수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding GoodQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="불량출고수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding DefectShipQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="불량수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding DefectQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="판매가능수량"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="{Binding SellableQty, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 출하대기 수량 -->
                        <Border Grid.Column="2" Style="{StaticResource SubSectionBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="출하대기 생성"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="기존재고 출하대기"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding StockShipQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="검수분 출하대기"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ResultShipQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="재고편입수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                                             Text="{Binding StockInQty, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="출하대기합계"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="{Binding ExpectedShipQty, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 누적 / 부족 -->
                        <Border Grid.Column="4" Style="{StaticResource SubSectionBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="누적 / 부족 정보"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="누적양품"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AccumulatedGoodQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="누적불량"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AccumulatedDefectQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="누적검수"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AccumulatedInspectedQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="예상부족수량"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ShortageQty, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 불량 내역 / 사진 -->
            <Border Grid.Row="4" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="90"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="불량 내역"/>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="90"
                        Content="불량추가"
                        Command="{Binding AddDefectCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Defects}"
                  SelectedItem="{Binding SelectedDefect, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="불량유형 검색" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Height="26"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding DefectCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding}"
                                     KeyDown="DefectTypeIdTextBox_KeyDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="불량유형ID"
                                    Binding="{Binding DefectTypeId}"
                                    IsReadOnly="True"
                                    Width="90"
                                    ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="불량코드"
                                    Binding="{Binding DefectCode}"
                                    IsReadOnly="True"
                                    Width="120"
                                    ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="대분류"
                                    Binding="{Binding Category1Name}"
                                    IsReadOnly="True"
                                    Width="140"
                                    ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="소분류"
                                    Binding="{Binding Category2Name}"
                                    IsReadOnly="True"
                                    Width="140"
                                    ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="메모"
                                    Binding="{Binding Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>

                            <DataGridTemplateColumn Header="사진" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="업로드"
                                    Height="26"
                                    Command="{Binding DataContext.UploadPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="삭제" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="삭제"
                                    Height="26"
                                    Command="{Binding DataContext.RemoveDefectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="4"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   Text="선택 불량 사진"/>

                    <Border Grid.Row="6"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
                        <ListBox ItemsSource="{Binding SelectedDefect.Attachments}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right"
                                    Width="50"
                                    Height="24"
                                    Content="삭제"
                                    Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                                        <TextBlock VerticalAlignment="Center"
                                       Text="{Binding FileName}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 메모 / 분할검수 / 저장 -->
            <Border Grid.Row="6" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="특이사항"/>

                        <TextBox Grid.Column="1"
                                 Height="54"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Content="분할검수"
                                  IsChecked="{Binding IsPartial, Mode=TwoWay}"/>

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="다음 검수일"/>

                        <DatePicker Grid.Column="3"
                                    Height="30"
                                    SelectedDate="{Binding NextInspectionDate, Mode=TwoWay}"/>

                        <TextBlock Grid.Column="4"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="사유"/>

                        <TextBox Grid.Column="5"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding PartialReason, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Foreground="#6B7280"
                               Text="저장 시 판매가능수량은 재고로 입고되고, 입력한 수량만큼 출하대기가 생성됩니다. 실제 재고 차감은 출하관리에서 진행됩니다."/>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="170"
                                Content="검수실적 및 출하대기 저장"
                                Command="{Binding SaveCommand}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="90"
                                Margin="8,0,0,0"
                                Content="취소"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>