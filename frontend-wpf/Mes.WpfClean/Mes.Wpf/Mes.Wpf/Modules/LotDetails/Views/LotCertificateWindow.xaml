<Window x:Class="Mes.Wpf.Modules.LotDetails.Views.LotCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOT 성적서 보기"
        Width="1500"
        Height="850"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8C2D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="HeaderCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="#F7F7F7"/>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 상단 툴바 -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#D5DCE6"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Text="LOT 성적서 보기"/>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Lot No."/>

                <TextBox Grid.Column="3"
                         Height="32"
                         Margin="8,0,0,0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Text="{Binding LotNo, Mode=OneWay}"/>  

                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           Text="제품명"/>

                <TextBox Grid.Column="6"
                         Height="32"
                         Margin="8,0,0,0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Text="{Binding ProductName, Mode=OneWay}"/>        

                <TextBlock Grid.Column="8"
                           VerticalAlignment="Center"
                           Text="규격(mm)"/>

                <TextBox Grid.Column="9"
                         Height="32"
                         Margin="8,0,0,0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Text="{Binding ProductSpec, Mode=OneWay}"/>        

                <StackPanel Grid.Column="11"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="인쇄"
                            Command="{Binding PrintCommand}"/>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="닫기"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 성적서 본문 -->
            <Border x:Name="CertificatePrintArea"
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="#B8C2D0"
                    BorderThickness="1"
                    Padding="10">       
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86"/>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="108"/>
                        <RowDefinition Height="306"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 제목 / 결재 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="390"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="Black"
                                BorderThickness="1.2"
                                Background="White">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       FontFamily="Malgun Gothic"
                                       Text="{Binding CertificateTitle}"/>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="작성"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="검토"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="승인"/>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" FontSize="22" Text="/"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" FontSize="22" Text="/"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" FontSize="22" Text="/"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 기본정보 -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="제품명"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding ProductName}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="규격(mm)"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding ProductSpec}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검사일자"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding InspectionDateText}"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="회사명"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding PartnerName}"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검수수량(EA)"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding InspectionTotalQtyText}"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Lot No."/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding LotNo}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검사자 (작업자)"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding InspectorName}"/>
                        </Border>
                    </Grid>

                    <!-- 검사방법 -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검사방법"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <CheckBox IsChecked="True" IsEnabled="False" Content="전수 검사(외관, 인쇄)" Margin="0,0,50,0"/>
                                <CheckBox IsChecked="True" IsEnabled="False" Content="샘플링 검사(치수)"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="샘플링 기준"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}"
                                       Text="• 검사수준 : 특별검사(S-1)        • 검사방법 : 보통검사 1회 샘플링 방식        • 합격품질수준(AQL) : 2.5"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="샘플링"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}">
                                <Run Text="• 로트크기(N) = "/>
                                <Run Text="{Binding InspectionTotalQtyText}"/>
                                <Run Text="        • 샘플문자 = "/>
                                <Run Text="{Binding SampleLetter}"/>
                                <Run Text="         • 샘플크기(n) = "/>
                                <Run Text="{Binding SampleSizeText}"/>
                                <Run Text="        • Ac = "/>
                                <Run Text="{Binding AcText}"/>
                                <Run Text="        Re = "/>
                                <Run Text="{Binding ReText}"/>
                            </TextBlock>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검사장비"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="True"
                                      IsEnabled="False"
                                      Content="줄자(SM-M-007 or SM-M-011)"/>
                        </Border>
                    </Grid>

                    <!-- 검사항목표 -->
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="130"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="No."/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검사 항목"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검사기준"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="단위"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="검 사 결 과"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource HeaderCellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="판정&#x0a;(P, F)"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="1"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="인쇄내용"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="한도견본과 비교"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="-"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding PrintContentResult}"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{Binding JudgmentText}"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="2"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="외관"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="흠, 이물, 찍힘 등의 유무"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="-"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding AppearanceResult}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{Binding JudgmentText}"/>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="3"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="인쇄상태"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="번짐이 없고 깨끗할 것"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="-"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding PrintStateResult}"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="5" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{Binding JudgmentText}"/>
                        </Border>

                        <!-- 치수 -->
                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="4"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="치수"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource ValueTextStyle}" Text="규격 ±1mm"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="mm x mm"/>
                        </Border>

                        <Grid Grid.Row="4" Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="샘플링"/>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="#1"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="#2"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="#3"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="#4"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="#5"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding DimensionSample1}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding DimensionSample2}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding DimensionSample3}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding DimensionSample4}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="{Binding DimensionSample5}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4" Grid.Column="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="68"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="최종 판정"/>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{Binding JudgmentText}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 우측 참고 영역 -->
            <StackPanel Grid.Column="2">
                <Border Background="White"
                        BorderBrush="#B8C2D0"
                        BorderThickness="1"
                        Padding="10">
                    <StackPanel>
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"
                                   Text="샘플문자 참고 (ISO 2859-1)"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="로트크기"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="특별 검사 수준"/>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HeaderCellBorderStyle}"/>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Foreground="#DC2626" Text="S-1"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="S-2"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="S-3"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource HeaderCellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="S-4"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="2 ~ 50"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Foreground="#DC2626" Text="A"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="A"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="A"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="C"/>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="51 ~ 500"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource LabelTextStyle}" Foreground="#DC2626" Text="B"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="C"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource CellBorderStyle}">
                                <TextBlock Style="{StaticResource ValueTextStyle}" Text="D"/>
                            </Border>
