<Window x:Class="Mes.Wpf.Modules.LotDetails.Views.LotDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOT 상세정보"
        Width="1120"
        Height="820"
        MinWidth="1050"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="SubSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="LOT 상세정보"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="{Binding LotNo}"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="#6B7280"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#DBEAFE"
                    BorderBrush="#93C5FD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,4"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding LotStatus}"
                           Foreground="#1D4ED8"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="2"
                Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="●"
                               Foreground="#2563EB"
                               FontSize="20"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="LOT 생성"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center">
                    <TextBlock Text="●"
                               FontSize="20"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutsourceInstructionCreated}" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="외주작업지시"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center">
                    <TextBlock Text="●"
                               FontSize="20"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutsourceWorkDone}" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="외주작업완료"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            HorizontalAlignment="Center">
                    <TextBlock Text="●"
                               FontSize="20"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInspectionDone}" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="검수완료"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LOT 기본정보 -->
                    <Border Grid.Column="0"
                            Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="LOT 기본정보"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="LOT 번호" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LotNo}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="상태" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LotStatus}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="재작업" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReworkText}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="부모 LOT" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ParentLotNo}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="LOT 수량" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LotQtyText}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="생성일" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding CreatedDateText}" Style="{StaticResource ValueStyle}"/>

                                <Border Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Style="{StaticResource SubSectionBorderStyle}"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="처리계획" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PlanTypeDisplayText}" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="출고목표" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PlanShipTargetQtyText}" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="계획현재고" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlanAvailableInventoryQtyText}" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="재고출하" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PlanStockShipQtyText}" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="생산필요" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlanProductionQtyText}" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="부족종료" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PlanShortCloseText}" Style="{StaticResource ValueStyle}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="납기일" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DueDateText}" Style="{StaticResource ValueStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 품목 / 수주정보 -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="품목 / 수주정보"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="거래처" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PartnerName}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="품목코드" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ProductCode}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="품목명" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ProductName}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="규격" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductSpec}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="판넬크기" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PlateSize}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="수주수량" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrderQtyText}" Style="{StaticResource ValueStyle}"/>

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="현재고" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding StockQtyText}" Style="{StaticResource ValueStyle}"/>

                                <Border Grid.Row="5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Style="{StaticResource SubSectionBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="특이사항"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"/>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding OrderMemoText}"
                                                   Foreground="#111827"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 외주 작업 정보 -->
                <Border Style="{StaticResource SectionBorderStyle}"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="외주 작업 정보"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <DataGrid ItemsSource="{Binding OutsourceWorks}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  Height="145"
                                  Background="White"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="지시번호" Binding="{Binding InstructionNo}" Width="130" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="공정" Binding="{Binding ProcessType}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="그룹" Binding="{Binding GroupSeq}" Width="70" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="원단 LOT" Binding="{Binding FabricLotNo}" Width="130" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="길이(m)" Binding="{Binding LengthM, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="시트수량" Binding="{Binding SheetQty, StringFormat={}{0:N0}}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="예상산출" Binding="{Binding ExpectedOutputQty, StringFormat={}{0:N0}}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="완료수량" Binding="{Binding ConfirmedOutsourceQty, StringFormat={}{0:N0}}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding Remark}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource SubSectionBorderStyle}"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="외주비고"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding OutsourceWorkMemoText}"
                                           Style="{StaticResource ValueStyle}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 검수 정보 -->
                <Border Style="{StaticResource SectionBorderStyle}"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="검수 정보"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="검수상태" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InspectionStatusText}" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="검수일" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding InspectionDateText}" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="등록일" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding InspectionResultCreatedAtText}" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="검수수량" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectedQtyText}" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="양품수량" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GoodQtyText}" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="4" Text="불량수량" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding DefectQtyText}" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="불량출고" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DefectShipQtyText}" Style="{StaticResource ValueStyle}"/>

                            <Border Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="6"
                                    Style="{StaticResource SubSectionBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="검수메모"
                                               Style="{StaticResource LabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InspectionMemoText}"
                                               Style="{StaticResource ValueStyle}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 불량 내역 -->
                <Border Style="{StaticResource SectionBorderStyle}"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="불량 내역"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <DataGrid ItemsSource="{Binding Defects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  Height="160"
                                  Background="White"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="불량코드" Binding="{Binding DefectTypeCode}" Width="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="불량명" Binding="{Binding DefectTypeName}" Width="180" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="수량" Binding="{Binding DefectQty, StringFormat={}{0:N0}}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="처리" Binding="{Binding Disposition}" Width="110" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="이미지" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Height="26"
                    Padding="8,0"
                    HorizontalAlignment="Center"
                    Content="{Binding AttachmentDisplayText}"
                    Command="{Binding DataContext.OpenDefectImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="IsEnabled" Value="False"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                <Setter Property="Background" Value="#EEF2FF"/>
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                <Setter Property="BorderBrush" Value="#C7D2FE"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="메모" Binding="{Binding Memo}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="닫기"
                    Width="100"
                    Height="34"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>