<Window x:Class="Mes.Wpf.Modules.LotDetails.Views.LotDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOT 상세정보"
        Width="1050"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="LOT 상세정보"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827" />
                <TextBlock Text="{Binding LotNo}"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="#6B7280" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#DBEAFE"
                    BorderBrush="#93C5FD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,4"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding LotStatus}"
                           Foreground="#1D4ED8"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="2"
                Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="●" Foreground="#2563EB" FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Text="LOT 생성" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="●" FontSize="20" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D1D5DB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutsourceInstructionCreated}" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="외주작업지시" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="●" FontSize="20" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D1D5DB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutsourceWorkDone}" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="외주작업완료" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="●" FontSize="20" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D1D5DB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInspectionDone}" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="검수완료" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LOT 기본정보 -->
                    <Border Grid.Column="0"
                            Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="LOT 기본정보" Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="LOT 번호" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LotNo}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="상태" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LotStatus}" Style="{StaticResource ValueStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="재작업" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReworkText}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="부모 LOT" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ParentLotNo}" Style="{StaticResource ValueStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="LOT 수량" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LotQtyText}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="생성일" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding CreatedDateText}" Style="{StaticResource ValueStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 품목 / 수주 정보 -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="품목 / 수주 정보" Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="거래처" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PartnerName}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="품목코드" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ProductCode}" Style="{StaticResource ValueStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="품목명" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ProductName}" Style="{StaticResource ValueStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="규격" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductSpec}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="판사이즈" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PlateSize}" Style="{StaticResource ValueStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="재고수량" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StockQtyText}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="납기일" Style="{StaticResource LabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding OrderDueDateText}" Style="{StaticResource ValueStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="특이사항" Style="{StaticResource LabelStyle}" />       
                                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding OrderMemoText}" TextWrapping="Wrap"
                                           Style="{StaticResource ValueStyle}" />   
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 외주작업 정보 -->
                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="외주작업 정보" Style="{StaticResource SectionTitleStyle}" />

                        <DataGrid ItemsSource="{Binding OutsourceWorks}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MinHeight="120"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="작업지시번호" Binding="{Binding InstructionNo}" Width="120" />
                                <DataGridTextColumn Header="작업일" Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}" Width="90" />
                                <DataGridTextColumn Header="공정" Binding="{Binding ProcessType}" Width="70" />
                                <DataGridTextColumn Header="그룹" Binding="{Binding GroupSeq}" Width="70" />
                                <DataGridTextColumn Header="원단LOT" Binding="{Binding FabricLotNo}" Width="120" />
                                <DataGridTextColumn Header="m수" Binding="{Binding LengthM}" Width="70" />
                                <DataGridTextColumn Header="시트수" Binding="{Binding SheetQty, StringFormat=N0}" Width="80" />
                                <DataGridTextColumn Header="컷수" Binding="{Binding SheetCutCount, StringFormat=N0}" Width="70" />
                                <DataGridTextColumn Header="예상수량" Binding="{Binding GroupExpectedOutputQty, StringFormat=N0}" Width="90" />
                                <DataGridTextColumn Header="완료Sheet" Binding="{Binding WorkDoneSheetQty, StringFormat=N0}" Width="90" />
                                <DataGridTextColumn Header="확정생산량" Binding="{Binding ConfirmedOutsourceQty, StringFormat=N0}" Width="100" />
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="작업지시 메모" Binding="{Binding Remark}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 검수실적 정보 -->
                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="검수실적 정보" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="검수상태" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InspectionStatusText}" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="검수일" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding InspectionDateText}" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="검수수량" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding InspectedQtyText}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="양품수량" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GoodQtyText}" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="불량수량" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DefectQtyText}" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="불량출고" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding DefectShipQtyText}" Style="{StaticResource ValueStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="특이사항" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding InspectionMemoText}" TextWrapping="Wrap" Style="{StaticResource ValueStyle}" />
                        </Grid>

                        <TextBlock Margin="0,8,0,4"
                                   Text="검수 불량 내역"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />

                        <DataGrid ItemsSource="{Binding Defects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="120"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="불량코드" Binding="{Binding DefectTypeCode}" Width="90" />
                                <DataGridTextColumn Header="불량명" Binding="{Binding DefectTypeName}" Width="150" />
                                <DataGridTextColumn Header="수량" Binding="{Binding DefectQty, StringFormat=N0}" Width="80" />
                                <DataGridTextColumn Header="처리" Binding="{Binding Disposition}" Width="90" />
                                <DataGridTextColumn Header="메모" Binding="{Binding Memo}" Width="*" />
                                <DataGridTemplateColumn Header="첨부 이미지" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center">

                                                <!-- 이미지 있음: 클릭 가능 -->
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>

                    <Hyperlink NavigateUri="{Binding FirstAttachmentImageUrl}"
                               RequestNavigate="AttachmentImage_RequestNavigate">
                        <Run Text="이미지" />
                    </Hyperlink>
                                                </TextBlock>

                                                <!-- 이미지 없음: 일반 텍스트 -->
                                                <TextBlock Text="없음"
                                                            Foreground="#6B7280">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Content="닫기"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>