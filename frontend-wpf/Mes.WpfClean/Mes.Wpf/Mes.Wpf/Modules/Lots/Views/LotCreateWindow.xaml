<Window x:Class="Mes.Wpf.Modules.Lots.Views.LotCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="추가/재작업 LOT 생성"
        Height="820"
        Width="1080"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="추가/재작업 LOT 생성"
                           FontSize="20"
                           FontWeight="Bold"/>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#666666"
                           Text="Primary LOT은 수주등록 시 자동 생성되며, 이 화면은 추가/재작업 LOT 생성 전용입니다."/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2"
                  Header="수주라인 정보"
                  Padding="12">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock FontWeight="SemiBold" Text="수주번호"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.OrderNo}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock FontWeight="SemiBold" Text="거래처"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.PartnerName}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock FontWeight="SemiBold" Text="품목코드"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.ProductCode}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,8">
                    <TextBlock FontWeight="SemiBold" Text="품목명"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.ProductName}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="수주수량"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.OrderQty}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="단위"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.Uom}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="납기일"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.DueDate, StringFormat=yyyy-MM-dd}"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="상태"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding EditModel.Status}"/>
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <GroupBox Grid.Row="4"
                  Header="부모 Primary LOT 선택 (재작업)"
                  Padding="12">
            <DockPanel>
                <CheckBox DockPanel.Dock="Top"
                          Margin="0,0,0,8"
                          Content="재작업 LOT 생성"
                          IsChecked="{Binding EditModel.IsRework}"
                          Click="ReworkCheckBox_Click"/>

                <DataGrid Height="120"
                          MaxHeight="120"
                          ItemsSource="{Binding PrimaryLots}"
                          SelectedItem="{Binding SelectedPrimaryLot}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsEnabled="{Binding EditModel.IsRework}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOT ID"
                                            Binding="{Binding LotId}"
                                            Width="80"/>
                        <DataGridTextColumn Header="LOT 번호"
                                            Binding="{Binding LotNo}"
                                            Width="180"/>
                        <DataGridTextColumn Header="수량"
                                            Binding="{Binding LotQty}"
                                            Width="90"/>
                        <DataGridTextColumn Header="단위"
                                            Binding="{Binding Uom}"
                                            Width="80"/>
                        <DataGridTextColumn Header="상태"
                                            Binding="{Binding Status}"
                                            Width="110"/>
                        <DataGridCheckBoxColumn Header="재작업가능"
                                                Binding="{Binding CanCreateRework}"
                                                Width="100"/>
                        <DataGridTextColumn Header="메모"
                                            Binding="{Binding Memo}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="품목정보"
                      Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="품목코드"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding EditModel.ProductCode}"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="품목명"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding EditModel.ProductName}"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="원단규격"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding EditModel.PanelSpecText}"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="컷수"/>
                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Text="{Binding EditModel.CutQtyPerPanel}"/>

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="제품규격"/>
                    <TextBlock Grid.Row="8"
                               Grid.Column="1"
                               Text="{Binding EditModel.ProductSpec}"/>

                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="도면번호"/>
                    <TextBlock Grid.Row="10"
                               Grid.Column="1"
                               Text="{Binding EditModel.DrawingNo}"/>

                    <TextBlock Grid.Row="12"
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Text="도면정보"/>
                    <StackPanel Grid.Row="12"
                                Grid.Column="1">
                        <TextBlock Text="{Binding EditModel.DrawingRevisionNo, StringFormat=리비전: {0}}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding EditModel.DrawingFileUri}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Margin="0,8,0,0"
                                    Orientation="Horizontal">           
                            <Button Width="100"
                                    Content="도면파일"
                                    Click="OpenDrawingFileButton_Click"/>       
                            <Button Width="100"
                                    Margin="8,0,0,0"
                                    Content="원본파일"
                                    Click="OpenOriginalFileButton_Click"/>  
                            <Button Width="100"
                                    Margin="8,0,0,0"
                                    Content="판작업 열기"
                                    Click="OpenPlateWorkButton_Click"/>     
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="생성정보"
                      Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="부모 LOT"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding EditModel.ParentLotNo}"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="원단 LOT"/>
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding EditModel.MaterialLotNo, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Text="원단 정보"/>   

                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="사용량"/>

                        <TextBlock Grid.Row="0"
               Grid.Column="2"
               Text="시트수"/>

                        <TextBox Grid.Row="2"
             Grid.Column="0"
             Text="{Binding EditModel.MaterialUsedQty, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Row="2"
             Grid.Column="2"
             Text="{Binding EditModel.MaterialSheetCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="계획수량"/>
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Text="{Binding EditModel.PlanQty, UpdateSourceTrigger=PropertyChanged}"/>

                    

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               VerticalAlignment="Top"
                               Text="메모"/>
                    <TextBox Grid.Row="8"
                             Grid.Column="1"
                             Height="120"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding EditModel.Memo, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="초기화"
                    Click="ResetButton_Click"/>
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="저장"
                    Click="SaveButton_Click"/>
            <Button Width="100"
                    Height="32"
                    Content="닫기"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>