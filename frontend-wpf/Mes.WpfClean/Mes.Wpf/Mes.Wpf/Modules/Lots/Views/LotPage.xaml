<UserControl x:Class="Mes.Wpf.Modules.Lots.Views.LotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="검색 영역" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="생성일(From~To)"/>
                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding SearchModel.CreatedDateFrom}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Text="~"/>
                <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding SearchModel.CreatedDateTo}"/>

                <TextBlock Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" Text="납기일(From~To)"/>
                <DatePicker Grid.Row="0" Grid.Column="6" SelectedDate="{Binding SearchModel.DueDateFrom}"/>
                <TextBlock Grid.Row="0" Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Center" Text="~"/>
                <DatePicker Grid.Row="0" Grid.Column="8" SelectedDate="{Binding SearchModel.DueDateTo}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="검색어"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="8"
                         Text="{Binding SearchModel.Keyword, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Row="2" Grid.Column="9"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="조회"
                            Command="{Binding SearchCommand}"/>
                    <Button Width="90"
                            Height="32"
                            Content="초기화"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="LOT 목록" Padding="8">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LOT번호" Binding="{Binding LotNo}" Width="160"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="주문번호" Binding="{Binding OrderNo}" Width="140"/>
                    <DataGridTextColumn Header="거래처" Binding="{Binding PartnerName}" Width="140"/>
                    <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="120"/>
                    <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="160"/>
                    <DataGridTextColumn Header="LOT수량" Binding="{Binding LotQty, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="80"/>
                    <DataGridTextColumn Header="납기일" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="공정 상세" Padding="8">
            <DataGrid ItemsSource="{Binding Steps}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="순서" Binding="{Binding StepSeq}" Width="70"/>
                    <DataGridTextColumn Header="공정코드" Binding="{Binding ProcessCode}" Width="120"/>
                    <DataGridTextColumn Header="공정명" Binding="{Binding ProcessName}" Width="180"/>
                    <DataGridTextColumn Header="공정유형" Binding="{Binding ProcessType}" Width="110"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="시작" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="완료" Binding="{Binding EndedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>

                    <DataGridTemplateColumn Header="액션" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="시작"
                                            Width="70"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.StartStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanStart}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="완료"
                                            Width="70"
                                            Command="{Binding DataContext.CompleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanComplete}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="Gray"
                                               Text="확인만">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutsource}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>