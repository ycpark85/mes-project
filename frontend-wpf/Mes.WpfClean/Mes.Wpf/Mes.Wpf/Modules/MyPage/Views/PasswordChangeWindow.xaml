<Window x:Class="Mes.Wpf.Modules.MyPage.Views.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 변경"
        Width="540"
        Height="600"
        MinWidth="540"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        Closing="Window_Closing">

    <Grid Margin="18">
        <Border Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding TitleText}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="{Binding DescriptionText}"
                               Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 현재 비밀번호 -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="현재 비밀번호"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#C7CDD8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Height="40"
                                     Padding="12,8"
                                     FontSize="14"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 새 비밀번호 -->
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="새 비밀번호"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#C7CDD8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <PasswordBox x:Name="NewPasswordBox"
                                     Height="40"
                                     Padding="12,8"
                                     FontSize="14"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 새 비밀번호 확인 -->
                <Grid Grid.Row="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="새 비밀번호 확인"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#C7CDD8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Height="40"
                                     Padding="12,8"
                                     FontSize="14"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 오류 메시지 -->
                <Border Grid.Row="9"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MinHeight="18"/>
                </Border>

                <!-- 버튼 영역 -->
                <Grid Grid.Row="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        
                        <ColumnDefinition Width="10"/>
                       
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#6B7280"
                               Text="비밀번호는 현재 비밀번호와 다르게 입력하세요."/>
                </Grid>
                <Grid Grid.Row="13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="225"/>
                        <ColumnDefinition Width="225"/>

                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="닫기"
                            Height="40"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="White"
                            Foreground="#374151"
                            BorderBrush="#C7CDD8"
                            BorderThickness="1"
                            Click="CloseButton_Click"/>

                    <Button Grid.Column="3"
                            Content="비밀번호 변경"
                            Height="40"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            Click="ChangeButton_Click"/>
                </Grid>


            </Grid>

        </Border>
    </Grid>
</Window>