<UserControl x:Class="Mes.Wpf.Modules.OrderLineList.Views.OrderLineListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Mes.Wpf.Core.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:OrderLineStatusToBrushConverter x:Key="OrderLineStatusToBrushConverter" />
        <conv:OrderLineStatusDisplayConverter x:Key="OrderLineStatusDisplayConverter" />
        <conv:OrderLineStatusToForegroundConverter x:Key="OrderLineStatusToForegroundConverter" />

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FA" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 검색 영역 -->
        <Border Grid.Row="0"
                Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="수주일자" />

                <DatePicker Grid.Column="1"
                            Height="32"
                            VerticalAlignment="Center"
                            SelectedDate="{Binding OrderDateFrom}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="~" />

                <DatePicker Grid.Column="3"
                            Height="32"
                            VerticalAlignment="Center"
                            SelectedDate="{Binding OrderDateTo}" />

                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="검색어" />

                <TextBox Grid.Column="6"
                         Height="32"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="8"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="상태" />

                <ComboBox Grid.Column="9"
                          Height="32"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}" />

                <Button Grid.Column="11"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0"
                        Content="조회"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="13"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0"
                        Content="초기화"
                        Command="{Binding ResetCommand}" />
            </Grid>
        </Border>

        <!-- 리스트 영역 -->
        <Border Grid.Row="2"
                Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="발주리스트"/>

                    <TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               Text="{Binding PageInfoText}"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Margin="0"
                          BorderThickness="0"
                          Background="White"
                          RowHeight="34"
                          ColumnHeaderHeight="38"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="거래처"
                                            Binding="{Binding PartnerName}"
                                            Width="180"
                                            ElementStyle="{StaticResource GridTextStyle}" />

                        <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding ProductCode}"
                                            Width="120"
                                            ElementStyle="{StaticResource GridTextStyle}" />

                        <DataGridTextColumn Header="품목명"
                                            Binding="{Binding ProductName}"
                                            Width="*"
                                            ElementStyle="{StaticResource GridTextStyle}" />

                        <DataGridTextColumn Header="수주일"
                                            Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}"
                                            Width="110"
                                            ElementStyle="{StaticResource GridTextStyle}" />

                        <DataGridTextColumn Header="납기일"
                                            Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}"
                                            Width="110"
                                            ElementStyle="{StaticResource GridTextStyle}" />

                        <DataGridTextColumn Header="수주수량"
                                            Binding="{Binding OrderQty, StringFormat={}{0:N0}}"
                                            Width="90"
                                            ElementStyle="{StaticResource GridTextStyle}" />

                        <DataGridTemplateColumn Header="상태"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource OrderLineStatusToForegroundConverter}}"
                                               Text="{Binding Status, Converter={StaticResource OrderLineStatusDisplayConverter}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="LOT 수"
                                            Binding="{Binding LotCount}"
                                            Width="60"
                                            ElementStyle="{StaticResource GridTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 페이지네이션 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#6B7280"
                       Text="{Binding PageInfoText}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="80"
                        Content="이전"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPreviousPage}" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0"
                        MinWidth="80"
                        Content="다음"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNextPage}" />
            </StackPanel>
        </Grid>

        <!-- 하단 액션 영역 -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="선택 상태: " />
                <TextBlock Text="{Binding OrderStatusDisplay}" />
                <TextBlock Margin="20,0,0,0" FontWeight="SemiBold" Text="LOT 액션: " />
                <TextBlock Text="{Binding LotActionButtonText}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="110"
                    Margin="0"
                    Content="발주상세"
                    Command="{Binding OpenOrderDetailCommand}" />

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="130"
                    Margin="0"
                    Content="{Binding LotActionButtonText}"
                    Command="{Binding OpenLotActionCommand}" />
        </Grid>
    </Grid>
</UserControl>