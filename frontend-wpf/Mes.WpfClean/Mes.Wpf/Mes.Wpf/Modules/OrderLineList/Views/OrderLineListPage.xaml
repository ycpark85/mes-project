<UserControl x:Class="Mes.Wpf.Modules.OrderLineList.Views.OrderLineListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Mes.Wpf.Core.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:OrderLineStatusToBrushConverter x:Key="OrderLineStatusToBrushConverter" />
        <conv:OrderLineStatusDisplayConverter x:Key="OrderLineStatusDisplayConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 검색 영역 -->
        <Border Grid.Row="0"
                Padding="16"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="수주일자" />

                <DatePicker Grid.Column="1"
                            Height="32"
                            SelectedDate="{Binding OrderDateFrom}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="~" />

                <DatePicker Grid.Column="3"
                            Height="32"
                            SelectedDate="{Binding OrderDateTo}" />

                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="검색어" />

                <TextBox Grid.Column="6"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="8"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="상태" />

                <ComboBox Grid.Column="9"
                          Height="32"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}" />

                <Button Grid.Column="11"
                        Height="32"
                        Content="조회"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="13"
                        Height="32"
                        Content="초기화"
                        Command="{Binding ResetCommand}" />
            </Grid>
        </Border>

        <!-- 리스트 영역 -->
        <Border Grid.Row="2"
                Padding="12"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="수주번호"
                                        Binding="{Binding OrderNo}"
                                        Width="130" />

                    <DataGridTextColumn Header="거래처"
                                        Binding="{Binding PartnerName}"
                                        Width="180" />

                    <DataGridTextColumn Header="품목코드"
                                        Binding="{Binding ProductCode}"
                                        Width="120" />

                    <DataGridTextColumn Header="품목명"
                                        Binding="{Binding ProductName}"
                                        Width="190" />

                    <DataGridTextColumn Header="수주일"
                                        Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}"
                                        Width="110" />

                    <DataGridTextColumn Header="납기일"
                                        Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}"
                                        Width="110" />

                    <DataGridTextColumn Header="수주수량"
                                        Binding="{Binding OrderQty, StringFormat={}{0:N0}}"
                                        Width="90" />

                    <DataGridTextColumn Header="단위"
                                        Binding="{Binding Uom}"
                                        Width="60" />

                    <DataGridTemplateColumn Header="상태"
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource OrderLineStatusToBrushConverter}}"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        HorizontalAlignment="Center">
                                    <TextBlock Foreground="White"
                                               FontWeight="SemiBold"
                                               Text="{Binding Status, Converter={StaticResource OrderLineStatusDisplayConverter}}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridCheckBoxColumn Header="LOT 여부"
                                            Binding="{Binding HasLot}"
                                            Width="65" />

                    <DataGridTextColumn Header="LOT 수"
                                        Binding="{Binding LotCount}"
                                        Width="60" />

                    
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 페이지네이션 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding PageInfoText}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button MinWidth="80"
                        Height="32"
                        Margin="0,0,8,0"
                        Content="이전"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPreviousPage}" />

                <Button MinWidth="80"
                        Height="32"
                        Content="다음"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNextPage}" />
            </StackPanel>
        </Grid>

        <!-- 하단 액션 영역 -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="선택 상태: " />
                <TextBlock Text="{Binding OrderStatusDisplay}" />
                <TextBlock Margin="20,0,0,0" FontWeight="SemiBold" Text="LOT 액션: " />
                <TextBlock Text="{Binding LotActionButtonText}" />
            </StackPanel>

            <Button Grid.Column="1"
                    MinWidth="110"
                    Height="34"
                    Content="발주상세"
                    Command="{Binding OpenOrderDetailCommand}" />

            <Button Grid.Column="3"
                    MinWidth="130"
                    Height="34"
                    Content="{Binding LotActionButtonText}"
                    Command="{Binding OpenLotActionCommand}" />
        </Grid>
    </Grid>
</UserControl>