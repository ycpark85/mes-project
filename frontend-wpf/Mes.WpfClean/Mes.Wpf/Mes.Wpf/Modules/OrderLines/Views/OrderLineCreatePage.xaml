<UserControl x:Class="Mes.Wpf.Modules.OrderLines.Views.OrderLineCreatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="수주번호" />
                <TextBox Grid.Column="1"
                         VerticalContentAlignment="Center"
                         Text="{Binding Header.OrderNo, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="수주일자" />
                <DatePicker Grid.Column="4"
                            VerticalContentAlignment="Center"
                            SelectedDate="{Binding Header.OrderDate}" />

                <TextBlock Grid.Column="6" VerticalAlignment="Center" FontWeight="SemiBold" Text="거래처" />
                <TextBox Grid.Column="7"
                         VerticalContentAlignment="Center"
                         Text="{Binding Header.PartnerName, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="9"
                        Height="32"
                        Content="찾기"
                        Click="PartnerSearchButton_Click" />

                <TextBlock Grid.Column="11" VerticalAlignment="Center" FontWeight="SemiBold" Text="납기일" />
                <DatePicker Grid.Column="12"
                            VerticalContentAlignment="Center"
                            SelectedDate="{Binding Header.DueDate}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="수주 라인" />
                    <Button DockPanel.Dock="Right"
                            Width="100"
                            Height="32"
                            Content="라인 추가"
                            Command="{Binding AddLineCommand}" />
                </DockPanel>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No"
                                            Width="50"
                                            Binding="{Binding LineNo}"
                                            IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="품목코드" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="ProductCodeTextBox_KeyDown" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="품목명"
                                            Width="180"
                                            Binding="{Binding ProductName}"
                                            IsReadOnly="True"/>     

                        <DataGridTextColumn Header="규격"
                                            Width="150"
                                            Binding="{Binding ProductSpec}"
                                            IsReadOnly="True"/>     

                        <DataGridTextColumn Header="단위"
                                            Width="70"
                                            Binding="{Binding Uom}"
                                            IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="수주수량(정)" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding OrderQty, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="OrderQtyTextBox_LostFocus" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="비고" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="도면" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DrawingNo}"
                                            Tag="{Binding}"
                                            Click="DrawingOpenButton_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Foreground}" />        
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="삭제" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="삭제"
                                            Tag="{Binding}"
                                            Click="RemoveLineButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold">
                    <Run Text="총 수주 라인 수 : " />
                    <Run Text="{Binding TotalLineCount, Mode=OneWay}" />
                    <Run Text="  |  총 수주 수량(정) : " />
                    <Run Text="{Binding TotalOrderQty, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    
                    <Button Width="100"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="수주저장"
                            Command="{Binding SaveCommand}" />
                    <Button Width="100"
                            Height="32"
                            Content="취소"
                            Command="{Binding ResetCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>