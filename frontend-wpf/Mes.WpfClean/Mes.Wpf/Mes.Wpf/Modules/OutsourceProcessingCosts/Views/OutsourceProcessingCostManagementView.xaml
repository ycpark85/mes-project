<UserControl x:Class="Mes.Wpf.Modules.OutsourceProcessingCosts.Views.OutsourceProcessingCostManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14"
                Margin="0,0,0,10"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="정산기준월"/>
                    <DatePicker Width="130"
                                SelectedDate="{Binding SettlementMonth}"/>
                </StackPanel>

                <CheckBox Content="선택월 기준 조회"
                          IsChecked="{Binding UseSettlementMonth}"
                          Margin="0,20,16,0"/>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="작업 시작일"/>
                    <DatePicker Width="130"
                                SelectedDate="{Binding DateFrom}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="작업 종료일"/>
                    <DatePicker Width="130"
                                SelectedDate="{Binding DateTo}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="공정"/>
                    <ComboBox Width="100"
                              ItemsSource="{Binding ProcessTypeOptions}"
                              SelectedValue="{Binding SelectedProcessType}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="상태"/>
                    <ComboBox Width="110"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedValue="{Binding SelectedStatusCode}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="검색어"/>
                    <TextBox Width="220"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Button Content="조회"
                        Width="78"
                        Height="30"
                        Margin="0,18,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SearchCommand}"/>

                <Button Content="초기화"
                        Width="78"
                        Height="30"
                        Margin="0,18,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetCommand}"/>
            </WrapPanel>
        </Border>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,10">
            <Border Padding="12"
                    Margin="0,0,8,0"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="표준작업비 합계"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding StandardTotal, StringFormat={}{0:N0}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Padding="12"
                    Margin="0,0,8,0"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="실제가공비 합계"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding ActualTotal, StringFormat={}{0:N0}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Padding="12"
                    Margin="0,0,8,0"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="원가차액"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding DifferenceTotal, StringFormat={}{0:N0}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Padding="12"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="미마감 건수"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding UnclosedCount, StringFormat={}{0:N0}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="등록대상"
                      Margin="0,0,10,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom"
                            Padding="8"
                            Background="#F8FAFC"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       Text="묶음 생성 후 기등록 비용묶음번호가 표시됩니다."/>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="선택 대상 가공비 묶음 생성"
                                        Width="180"
                                        Height="30"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource WarningButtonStyle}"
                                        Command="{Binding CreateGroupCommand}"
                                        IsEnabled="{Binding CanCreateBundle}"/>
                                <Button Content="선택 행 저장"
                                        Width="100"
                                        Visibility="Collapsed"
                                        Height="30"
                                        Margin="0,0,8,0"
                                        Command="{Binding SaveCostCommand}"/>
                                <Button Content="엑셀 다운로드"
                                        Width="110"
                                        Height="30"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding SelectedTarget}"
                              Style="{StaticResource DenseDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource DataGridTextElementStyle}" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="선택"
                                                    Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Focusable="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="상태"
                                                    Width="80"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CostStatusName}"
                                                   Tag="{Binding StatusVisualCode}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Style="{StaticResource StatusTextStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="작업일"
                                                Width="95"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="공정"
                                                Width="70"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding ProcessTypeName}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="외주처"
                                                Width="150"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding PartnerName}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="품목명"
                                                Width="260"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding ProductNamesText}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="표준작업비"
                                                Width="105"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding StandardAmount, StringFormat={}{0:N0}}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="실제가공비"
                                                Width="105"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding ActualAmount, StringFormat={}{0:N0}}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="원가차액"
                                                Width="90"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding AmountDifference, StringFormat={}{0:N0}}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="비용묶음번호"
                                                Width="170"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding AlreadyCostGroupNo}"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="마감월"
                                                Width="90"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                Binding="{Binding SettlementMonth, StringFormat=yyyy-MM}"
                                                IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="선택 대상 가공비 입력"
                              Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding SelectedTarget.AlreadyCostGroupNo, StringFormat=비용묶음번호: {0}}"
                                       FontWeight="SemiBold"/>
                            <Border Tag="{Binding SelectedTarget.StatusVisualCode}"
                                    Style="{StaticResource StatusBadgeBorderStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0">
                                <TextBlock Text="{Binding SelectedTarget.CostStatusName}"
                                           Tag="{Binding SelectedTarget.StatusVisualCode}"
                                           Style="{StaticResource StatusBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="표준작업비"
                              Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="공급가액"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding StandardAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0}}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,8,0,0"
                                       Text="산정메모"
                                       VerticalAlignment="Top"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Height="56"
                                     Margin="0,8,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding StandardMemo, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Content="표준 저장"
                                    Width="90"
                                    Height="30"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCostCommand}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="실제가공비"
                              Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="공급가액"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding ActualAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0}}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,8,0,0"
                                       Text="업체청구월"
                                       VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        Text="{Binding ActualBillingMonth, Mode=OneWay, StringFormat={}{0:yyyy-MM}}"
                                        SelectedDate="{Binding ActualBillingMonth}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,8,0,0"
                                       Text="청구메모"
                                       VerticalAlignment="Top"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Height="56"
                                     Margin="0,8,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding ActualMemo, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Row="3"
                                    Grid.Column="1"
                                    Content="실제 저장"
                                    Width="90"
                                    Height="30"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCostCommand}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="월마감">
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding SelectedCostGroup.AmountDifference, StringFormat=원가차액: {0:N0}}"
                                       Margin="0,0,0,8"/>
                            <TextBox Height="48"
                                     Margin="0,0,0,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
                            <UniformGrid Columns="3">
                                <Button Content="월마감"
                                        MinWidth="0"
                                        Height="30"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Command="{Binding CloseCommand}"/>
                                <Button Content="마감취소"
                                        MinWidth="0"
                                        Height="30"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource WarningButtonStyle}"
                                        Command="{Binding ReopenCommand}"/>
                                <Button Content="취소처리"
                                        MinWidth="0"
                                        Height="30"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding CancelCommand}"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GroupBox Grid.Row="3"
                  Header="LOT별 배부 내역"
                  Margin="0,10,0,0"
                  Height="200">
            <DataGrid ItemsSource="{Binding Allocations}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LOT번호"
                                        Width="120"
                                        Binding="{Binding LotNo}"/>
                    <DataGridTextColumn Header="제품명"
                                        Width="220"
                                        Binding="{Binding ProductName}"/>
                    <DataGridTextColumn Header="기준"
                                        Width="70"
                                        Binding="{Binding BasisTypeName}"/>
                    <DataGridTextColumn Header="기준값"
                                        Width="100"
                                        Binding="{Binding BasisValue, StringFormat={}{0:N3}}"/>
                    <DataGridTextColumn Header="배부율"
                                        Width="80"
                                        Binding="{Binding AllocationRatioPercent, StringFormat={}{0:N2}%}"/>
                    <DataGridTextColumn Header="표준배부"
                                        Width="100"
                                        Binding="{Binding StandardAllocatedAmount, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="실제배부"
                                        Width="100"
                                        Binding="{Binding ActualAllocatedAmount, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="원가차액"
                                        Width="90"
                                        Binding="{Binding AmountDifference, StringFormat={}{0:N0}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
