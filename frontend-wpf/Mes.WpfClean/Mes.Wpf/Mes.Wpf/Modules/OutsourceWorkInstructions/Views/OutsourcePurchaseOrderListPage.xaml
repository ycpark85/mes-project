<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourcePurchaseOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="PurchaseOrderListDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style x:Key="PurchaseOrderListHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="PurchaseOrderListCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="PurchaseOrderListRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PurchaseOrderListTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PurchaseOrderListCenterTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PurchaseOrderListTextStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PurchaseOrderListRightTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PurchaseOrderListTextStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="PurchaseOrderDownloadButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="시작일" VerticalAlignment="Center" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2" Text="종료일" VerticalAlignment="Center" />
                <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="4" Text="공정구분" VerticalAlignment="Center" />
                <ComboBox Grid.Column="5"
                          ItemsSource="{Binding ProcessTypeOptions}"
                          SelectedItem="{Binding SelectedProcessType}" />

                <TextBlock Grid.Column="6" Text="검색어" VerticalAlignment="Center" />
                <TextBox Grid.Column="7"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="8" Content="조회" Command="{Binding SearchCommand}" MinWidth="80" />
                <Button Grid.Column="10" Content="초기화" Command="{Binding ResetCommand}" MinWidth="80" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Background="White">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource PurchaseOrderListDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource PurchaseOrderListHeaderStyle}"
                      CellStyle="{StaticResource PurchaseOrderListCellStyle}"
                      RowStyle="{StaticResource PurchaseOrderListRowStyle}"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="발주일자"
                                        Binding="{Binding PurchaseOrderDate}"
                                        Width="130"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource PurchaseOrderListCenterTextStyle}" />

                    <DataGridTextColumn Header="발주번호"
                                        Binding="{Binding PurchaseOrderNo}"
                                        Width="190"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource PurchaseOrderListCenterTextStyle}" />

                    <DataGridTextColumn Header="공정구분"
                                        Binding="{Binding ProcessType}"
                                        Width="90"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource PurchaseOrderListCenterTextStyle}" />

                    <DataGridTextColumn Header="외주처"
                                        Binding="{Binding OutsourcePartnerName}"
                                        Width="140"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource PurchaseOrderListCenterTextStyle}" />

                    <DataGridTextColumn Header="수량"
                                        Binding="{Binding Qty, StringFormat=N0}"
                                        Width="110"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource PurchaseOrderListCenterTextStyle}" />

                    <DataGridTextColumn Header="비고"
                                        Binding="{Binding Remark}"
                                        Width="*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource PurchaseOrderListCenterTextStyle}" />

                    <DataGridTemplateColumn Header="다운로드" Width="110" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="다운로드"
                                        Style="{StaticResource PurchaseOrderDownloadButtonStyle}"
                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding PageInfo}"
                           VerticalAlignment="Center"
                           Foreground="#374151"
                           FontWeight="SemiBold" />

                <Button Grid.Column="1"
                        Content="이전"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        MinWidth="80" />

                <Button Grid.Column="3"
                        Content="다음"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        MinWidth="80" />
            </Grid>
        </Border>

        <Grid Grid.RowSpan="5"
              Background="#66000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="240"
                    Height="100"
                    Background="White"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="16">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="다운로드 중입니다..."
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <ProgressBar Width="170"
                                 Height="12"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
