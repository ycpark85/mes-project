<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourcePurchaseOrderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="재단 발주 대상">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding CutGroups}"
                              SelectedItem="{Binding SelectedCutGroup}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="작업지시번호" Binding="{Binding InstructionNo}" Width="130" />
                            <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="70" />
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotSummary}" Width="220" />
                            <DataGridTextColumn Header="외주처" Binding="{Binding OutsourcePartnerName}" Width="120" />
                            <DataGridTextColumn Header="입고처" Binding="{Binding InboundPartnerName}" Width="100" />
                            <DataGridTextColumn Header="수량" Binding="{Binding TotalQty}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="인쇄 발주 대상">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding PrintGroups}"
                              SelectedItem="{Binding SelectedPrintGroup}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="작업지시번호" Binding="{Binding InstructionNo}" Width="130" />
                            <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="70" />
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotSummary}" Width="220" />
                            <DataGridTextColumn Header="외주처" Binding="{Binding OutsourcePartnerName}" Width="120" />
                            <DataGridTextColumn Header="입고처" Binding="{Binding InboundPartnerName}" Width="100" />
                            <DataGridTextColumn Header="수량" Binding="{Binding TotalQty}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="발주서 헤더정보">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="작업지시번호" />
                            <TextBox Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding SelectedGroup.InstructionNo}" />

                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="공정" />
                            <TextBox Grid.Column="4"
                                     IsReadOnly="True"
                                     Text="{Binding SelectedGroup.ProcessType}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="발주일자" />
                            <DatePicker Grid.Column="1"
                                        SelectedDate="{Binding EditModel.PurchaseOrderDate}" />

                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="납기일자" />
                            <DatePicker Grid.Column="4"
                                        SelectedDate="{Binding EditModel.DueDate}" />
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="입고처" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding EditModel.InboundPartnerName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="외주처" />
                            <TextBox Grid.Column="4"
                                     Text="{Binding EditModel.OutsourcePartnerName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="발주서 상세입력">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Top" Text="작업내용" />
                            <TextBox Grid.Column="1"
                                     Height="60"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding EditModel.WorkDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Top" Text="비고" />
                            <TextBox Grid.Column="1"
                                     Height="60"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding EditModel.Remark, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="수량" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding EditModel.Qty, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="단가" />
                            <TextBox Grid.Column="4"
                                     Text="{Binding EditModel.UnitPrice, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="공급가액" />
                            <TextBox Grid.Column="7"
                                     IsReadOnly="True"
                                     Text="{Binding EditModel.SupplyAmount}" />

                            <TextBlock Grid.Column="9" VerticalAlignment="Center" Text="부가세" />
                            <TextBox Grid.Column="10"
                                     IsReadOnly="True"
                                     Text="{Binding EditModel.VatAmount}" />

                            <TextBlock Grid.Column="12" VerticalAlignment="Center" Text="합계" />
                            <TextBox Grid.Column="13"
                                     IsReadOnly="True"
                                     Text="{Binding EditModel.TotalAmount}" />
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="4" Header="작업지시 LOT / 파일">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.1*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding SelectedGroup.Items}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LOT No" Binding="{Binding LotNo}" Width="120" />
                                <DataGridTextColumn Header="수주번호" Binding="{Binding OrderNo}" Width="120" />
                                <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="110" />
                                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="170" />
                                <DataGridTextColumn Header="수량" Binding="{Binding LotQty}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedGroup.Files}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="220" />
                                <DataGridTextColumn Header="경로" Binding="{Binding FilePath}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="새로고침"
                    Command="{Binding RefreshCommand}" />
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="초기화"
                    Command="{Binding ResetCommand}" />
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="저장"
                    Command="{Binding SaveCommand}" />
            <Button Width="90"
                    Height="32"
                    Content="출력"
                    Command="{Binding PrintCommand}" />
        </StackPanel>
    </Grid>
</UserControl>