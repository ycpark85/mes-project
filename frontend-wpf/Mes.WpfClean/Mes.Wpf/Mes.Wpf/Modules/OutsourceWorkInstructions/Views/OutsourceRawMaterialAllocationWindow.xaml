<Window x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourceRawMaterialAllocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="원자재 배정"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="사용 M수"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="2"
                     Height="30"
                     IsReadOnly="True"
                     Background="#F5F5F5"
                     VerticalContentAlignment="Center"
                     Text="{Binding RequiredQty, Mode=OneWay, StringFormat={}{0:N2}}" />

            <TextBlock Grid.Column="4"
                       Text="배정합계"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="6"
                     Height="30"
                     IsReadOnly="True"
                     Background="#F5F5F5"
                     VerticalContentAlignment="Center"
                     Text="{Binding TotalAllocationQty, Mode=OneWay, StringFormat={}{0:N2}}" />

            <TextBlock Grid.Column="8"
                       Text="미배정"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="10"
                     Height="30"
                     IsReadOnly="True"
                     Background="#F5F5F5"
                     VerticalContentAlignment="Center"
                     Text="{Binding RemainingQty, Mode=OneWay, StringFormat={}{0:N2}}" />

            <TextBlock Grid.Column="12"
                       Text="배정수량"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="14"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Text="{Binding AllocationInputQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}, TargetNullValue=''}" />

            <Button Grid.Column="16"
                    Height="30"
                    Content="배정"
                    Command="{Binding AssignSelectedLotCommand}" />
            <Button Grid.Column="18"
                    Height="30"
                    Content="취소"
                    Command="{Binding ClearSelectedLotCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="원자재"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Height="30"
                      ItemsSource="{Binding Materials}"
                      SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                      DisplayMemberPath="MaterialName" />

            <TextBlock Grid.Column="3"
                       Text="위치"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="4"
                      Height="30"
                      ItemsSource="{Binding Locations}"
                      SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                      DisplayMemberPath="LocationName" />

            <Button Grid.Column="6"
                    Height="30"
                    Content="조회"
                    Command="{Binding SearchLotsCommand}" />
        </Grid>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding LotRows}"
                  SelectedItem="{Binding SelectedLotRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="원자재코드" Binding="{Binding MaterialCode, Mode=OneWay}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="원자재명" Binding="{Binding MaterialName, Mode=OneWay}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="위치" Binding="{Binding LocationName, Mode=OneWay}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="LOT번호" Binding="{Binding LotNo, Mode=OneWay}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn Header="현재고(M)" Binding="{Binding CurrentQty, Mode=OneWay, StringFormat={}{0:N2}}" Width="95" IsReadOnly="True" />
                <DataGridTextColumn Header="예약(M)" Binding="{Binding ReservedQty, Mode=OneWay, StringFormat={}{0:N2}}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="가용(M)" Binding="{Binding AvailableQty, Mode=OneWay, StringFormat={}{0:N2}}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="배정(M)"
                                    Binding="{Binding AllocationQty, Mode=OneWay, StringFormat={}{0:N2}}"
                                    Width="90"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="배정 후 잔량" Binding="{Binding BalanceAfter, Mode=OneWay, StringFormat={}{0:N2}}" Width="105" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="적용"
                    Command="{Binding ApplyCommand}" />
            <Button Width="90"
                    Height="32"
                    Content="취소"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
