<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourceWorkInstructionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="후보 LOT 목록">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom"
                            Height="32"
                            Margin="0,8,0,0"
                            Content="작업지시 추가"
                            Command="{Binding AddDraftCommand}" />

                    <DataGrid ItemsSource="{Binding CandidateLots}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected}" Width="55" />
                            <DataGridTextColumn Header="LOT No" Binding="{Binding LotNo}" Width="120" />
                            <DataGridTextColumn Header="거래처" Binding="{Binding PartnerName}" Width="140" />
                            <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="110" />
                            <DataGridTextColumn Header="수량" Binding="{Binding LotQty}" Width="90" />
                            <DataGridTextColumn Header="공정" Binding="{Binding ProcessText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="추가된 작업지시 목록">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Bottom"
                                Height="32"
                                Margin="0,8,0,0"
                                Content="선택 작업지시 제거"
                                Command="{Binding RemoveDraftCommand}" />

                        <DataGrid ItemsSource="{Binding Drafts}"
                                  SelectedItem="{Binding SelectedDraft}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="작업일" Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}" Width="110" />
                                <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="70" />
                                <DataGridTextColumn Header="외주처" Binding="{Binding PartnerName}" Width="140" />
                                <DataGridTextColumn Header="LOT" Binding="{Binding LotSummary}" Width="240" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="작업지시 상세">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding SelectedDraft.InstructionDate}" />

                            <TextBox Grid.Column="2"
                                     IsReadOnly="True"
                                     Text="{Binding SelectedDraft.PartnerName}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Height="70"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding SelectedDraft.Memo, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="2"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    Content="판데이터 첨부"
                                    Command="{Binding UploadFileCommand}" />
                        </Grid>

                        <TextBlock Grid.Row="4"
                                   Text="선택 LOT"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />

                        <DataGrid Grid.Row="6"
                                  ItemsSource="{Binding SelectedDraft.Lots}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LOT No" Binding="{Binding LotNo}" Width="120" />
                                <DataGridTextColumn Header="수주번호" Binding="{Binding OrderNo}" Width="110" />
                                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="170" />
                                <DataGridTextColumn Header="수량" Binding="{Binding LotQty}" Width="80" />
                                <DataGridTextColumn Header="공정" Binding="{Binding ProcessText}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="초기화"
                    Command="{Binding ResetCommand}" />
            <Button Width="120"
                    Height="32"
                    Content="작업지시 저장"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>