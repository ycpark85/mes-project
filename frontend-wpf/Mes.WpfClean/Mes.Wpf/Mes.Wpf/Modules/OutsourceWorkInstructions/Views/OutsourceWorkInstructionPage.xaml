<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourceWorkInstructionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 영역 그대로 유지 -->
            <GroupBox Grid.Column="0" Header="후보 LOT 목록">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom"
                            Height="32"
                            Margin="0,8,0,0"
                            Content="작업지시 추가"
                            Command="{Binding AddDraftCommand}" />

                    <DataGrid ItemsSource="{Binding CandidateLots}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected}" Width="55" />
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="120" />
                            <DataGridTextColumn Header="거래처" Binding="{Binding CustomerPartnerName}" Width="140" />
                            <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="110" />
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="180" />
                            <DataGridTextColumn Header="발주수량" Binding="{Binding LotQty}" Width="90" />
                            <DataGridTextColumn Header="공정" Binding="{Binding ProcessText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- 상단 목록 높이 조금 축소 -->
                    <RowDefinition Height="0.72*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1.28*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="추가된 작업지시 목록">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Bottom"
                                Height="32"
                                Margin="0,8,0,0"
                                Content="선택 작업지시 제거"
                                Command="{Binding RemoveDraftCommand}" />

                        <DataGrid ItemsSource="{Binding Drafts}"
                                  SelectedItem="{Binding SelectedDraft}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="작업일" Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="60" />
                                <DataGridTextColumn Header="거래처" Binding="{Binding CustomerPartnerName}" Width="130" />
                                <DataGridTextColumn Header="LOT" Binding="{Binding LotSummary}" Width="180" />
                                <DataGridTextColumn Header="판사이즈" Binding="{Binding PlateSize}" Width="90" />
                                <DataGridTextColumn Header="규격" Binding="{Binding Spec}" Width="90" />
                                <DataGridTextColumn Header="컷수" Binding="{Binding CutCountText}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="작업지시 상세">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 판데이터 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    Padding="6,6"
                                    MinHeight="32">
                                <TextBlock Text="{Binding SelectedDraft.PlateDataPath}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Button Grid.Column="2"
                                    Height="32"
                                    Content="판데이터 첨부"
                                    Command="{Binding UploadFileCommand}" />
                        </Grid>

                        <!-- 작업 조건 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="m수" />
                            <TextBox Grid.Column="1"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.LengthM, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="매수" />
                            <TextBox Grid.Column="4"
                                     Height="30"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.SheetQty}" />

                            <TextBlock Grid.Column="6"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="총 컷수" />
                            <TextBox Grid.Column="7"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.SheetCutCount, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="8"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#6B7280"
                                       Text="개별은 DB 컷수 사용 / 묶음은 직접 입력" />
                        </Grid>

                        <!-- 원단 LOT -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="원단LOT" />

                            <TextBox Grid.Column="1"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.FabricLotNo, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- 메모 -->
                        <TextBlock Grid.Row="6"
                                   Text="메모"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />

                        <TextBox Grid.Row="8"
                                 Height="50"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedDraft.Memo, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- 선택 LOT -->
                        <TextBlock Grid.Row="10"
                                   Text="선택 LOT"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"
                                   VerticalAlignment="Top" />

                        <DataGrid Grid.Row="10"
                                  Margin="0,24,0,0"
                                  ItemsSource="{Binding SelectedDraft.Lots}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="110" />
                                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="180" />
                                <DataGridTextColumn Header="수량" Binding="{Binding LotQty}" Width="70" />
                                <DataGridTextColumn Header="공정" Binding="{Binding ProcessText}" Width="90" />
                                <DataGridTextColumn Header="기본컷수" Binding="{Binding CutCountText}" Width="70" />
                                <DataGridTextColumn Header="묶음컷수" Binding="{Binding ManualCutsPerSheet, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="초기화"
                    Command="{Binding ResetCommand}" />
            <Button Width="120"
                    Height="32"
                    Content="작업지시 저장"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>