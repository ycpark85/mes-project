<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourceWorkInstructionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="WorkflowStepButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InputSourceSelectorStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 2단계 작업 흐름 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="1. LOT 및 작업지시 구성"
                    Command="{Binding ShowCompositionStepCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource WorkflowStepButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompositionStep}" Value="True">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#2563EB" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2"
                    Content="2. 작업 상세 입력"
                    Command="{Binding ShowDetailStepCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource WorkflowStepButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailStep}" Value="True">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#2563EB" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- 1단계: LOT 및 작업지시 구성 -->
        <Grid Grid.Row="2"
              Visibility="{Binding IsCompositionStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="후보 LOT 목록">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom"
                            Height="34"
                            Margin="0,8,0,0"
                            Content="작업지시 추가"
                            Command="{Binding AddDraftCommand}" />

                    <DataGrid ItemsSource="{Binding CandidateLots}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="선택" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="115" IsReadOnly="True" />
                            <DataGridTextColumn Header="거래처" Binding="{Binding CustomerPartnerName}" Width="135" IsReadOnly="True" />
                            <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="발주수량" Binding="{Binding LotQty, StringFormat={}{0:N0}}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="현재고" Binding="{Binding CurrentStockQty, StringFormat={}{0:N0}}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="공정" Binding="{Binding ProcessText}" Width="110" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.85*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1.15*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="추가된 작업지시 목록">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Bottom"
                                Height="32"
                                Margin="0,8,0,0"
                                Content="선택 작업지시 제거"
                                Command="{Binding RemoveDraftCommand}" />

                        <DataGrid ItemsSource="{Binding Drafts}"
                                  SelectedItem="{Binding SelectedDraft}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="상태" Binding="{Binding ConfigurationStatusText}" Width="75" />
                                <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="55" />
                                <DataGridTextColumn Header="거래처" Binding="{Binding CustomerPartnerName}" Width="125" />
                                <DataGridTextColumn Header="대표 LOT / 품목" Binding="{Binding RepresentativeLotText}" Width="*" />
                                <DataGridTextColumn Header="품목수" Binding="{Binding Lots.Count}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="선택 LOT 및 대표품목">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="10,7"
                                Background="#F8FAFC"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="대표품목" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SelectedDraft.RepresentativeLotText}"
                                           Foreground="#374151"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="4"
                                        Width="128"
                                        Height="32"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="대표품목 지정"
                                        Command="{Binding SetRepresentativeLotCommand}" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedDraft.Lots}"
                                  SelectedItem="{Binding SelectedDraft.SelectedLot, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="대표" Binding="{Binding RepresentativeMarker}" Width="48" IsReadOnly="True" />
                                <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="105" IsReadOnly="True" />
                                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="수량" Binding="{Binding LotQty, StringFormat={}{0:N0}}" Width="68" IsReadOnly="True" />
                                <DataGridTextColumn Header="원단폭" Binding="{Binding PanelWidthMm, StringFormat={}{0:N0}}" Width="68" IsReadOnly="True" />
                                <DataGridTextColumn Header="공정" Binding="{Binding ProcessText}" Width="75" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 2단계: 작업 상세 입력 -->
        <Grid Grid.Row="2"
              Visibility="{Binding IsDetailStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,8"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="85" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedDraft.DetailStatusText}"
                               Foreground="#2563EB"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedDraft.BundleText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SelectedDraft.RepresentativeLotText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding SelectedDraft.CustomerPartnerName, StringFormat='거래처  {0}'}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding SelectedDraft.TotalLotQty, StringFormat='수량  {0:N0}'}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{Binding SelectedDraft.PlateSize, StringFormat='판사이즈  {0}'}" VerticalAlignment="Center" />
                    <Button Grid.Column="9" Height="30" Content="이전 작업" Command="{Binding SelectPreviousDraftCommand}" />
                    <TextBlock Grid.Column="10" Text="{Binding SelectedDraftPositionText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Grid.Column="11" Height="30" Content="다음 작업" Command="{Binding SelectNextDraftCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.68*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="추가된 작업지시">
                    <DataGrid Margin="8"
                              ItemsSource="{Binding Drafts}"
                              SelectedItem="{Binding SelectedDraft}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="상태" Binding="{Binding DetailStatusText}" Width="75" />
                            <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="55" />
                            <DataGridTextColumn Header="거래처" Binding="{Binding CustomerPartnerName}" Width="110" />
                            <DataGridTextColumn Header="수량" Binding="{Binding TotalLotQty, StringFormat={}{0:N0}}" Width="78" />
                            <DataGridTextColumn Header="판사이즈" Binding="{Binding PlateSize}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="작업지시 상세 입력">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <!-- 작업 대상 LOT와 LOT별 묶음 컷수 -->
                            <GroupBox Header="작업 대상 LOT 및 묶음 컷수">
                                <DataGrid Margin="8"
                                          Height="150"
                                          ItemsSource="{Binding SelectedDraft.Lots}"
                                          SelectedItem="{Binding SelectedDraft.SelectedLot, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="대표" Binding="{Binding RepresentativeMarker}" Width="48" IsReadOnly="True" />
                                        <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="105" IsReadOnly="True" />
                                        <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="수량" Binding="{Binding LotQty, StringFormat={}{0:N0}}" Width="75" IsReadOnly="True" />
                                        <DataGridTextColumn Header="판사이즈" Binding="{Binding PlateSizeText}" Width="105" IsReadOnly="True" />
                                        <DataGridTextColumn Header="기본컷수" Binding="{Binding CutCountText}" Width="72" IsReadOnly="True" />
                                        <DataGridTextColumn Header="묶음컷수"
                                                            Binding="{Binding ManualCutsPerSheet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                            Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <!-- 투입 형태 -->
                            <Border Margin="0,8,0,0"
                                    Padding="10,8"
                                    Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="투입 형태" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="롤 원단"
                                            Command="{Binding ChangeInputSourceCommand}"
                                            CommandParameter="RAW_MATERIAL">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource InputSourceSelectorStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDraft.IsRawMaterialSource}" Value="True">
                                                        <Setter Property="Background" Value="#2563EB" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="3"
                                            Content="자가사용 시트지"
                                            Command="{Binding ChangeInputSourceCommand}"
                                            CommandParameter="SELF_USE_SHEET">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource InputSourceSelectorStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDraft.IsSelfUseSheetSource}" Value="True">
                                                        <Setter Property="Background" Value="#2563EB" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Grid.Column="4"
                                               Margin="12,0,0,0"
                                               Text="{Binding SelectedDraft.InputSourceGuide}"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 롤 원단 입력 -->
                            <Border Margin="0,8,0,0"
                                    Padding="10,8"
                                    Background="#FFFFFF"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    Visibility="{Binding SelectedDraft.IsRawMaterialSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="사용 M수" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Height="30" Text="{Binding SelectedDraft.LengthM, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="투입 매수" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="4" Height="30" IsReadOnly="True" Background="#F5F5F5" Text="{Binding SelectedDraft.SheetQty, StringFormat={}{0:N0}}" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="6" Height="30" Content="원자재 배정" Command="{Binding OpenRawMaterialAllocationCommand}" />
                                        <TextBlock Grid.Column="7" Margin="12,0,0,0" Text="{Binding SelectedDraft.RawMaterialAllocationSummary}" Foreground="#374151" VerticalAlignment="Center" />
                                    </Grid>

                                    <DataGrid Grid.Row="2"
                                              MaxHeight="110"
                                              ItemsSource="{Binding SelectedDraft.RawMaterialAllocations}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="원자재" Binding="{Binding MaterialName}" Width="*" />
                                            <DataGridTextColumn Header="위치" Binding="{Binding LocationName}" Width="125" />
                                            <DataGridTextColumn Header="원자재 LOT" Binding="{Binding LotNo}" Width="145" />
                                            <DataGridTextColumn Header="배정(M)" Binding="{Binding Qty, StringFormat={}{0:N2}}" Width="90" />
                                            <DataGridTextColumn Header="배정 후 잔량" Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- 자가사용 시트지 입력 -->
                            <Border Margin="0,8,0,0"
                                    Padding="10,8"
                                    Background="#FFFFFF"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    Visibility="{Binding SelectedDraft.IsSelfUseSheetSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="자가사용 시트지" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1">
                                            <ComboBox Height="30"
                                                      ItemsSource="{Binding SelectedDraft.AvailableSelfUseSheets}"
                                                      SelectedItem="{Binding SelectedDraft.SelectedSelfUseSheet}"
                                                      DisplayMemberPath="DisplayText"
                                                      IsTextSearchEnabled="True"
                                                      IsEnabled="{Binding SelectedDraft.HasAvailableSelfUseSheets}" />
                                            <TextBlock Text="- (없음)"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#64748B"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding SelectedDraft.IsSelfUseSheetUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="투입 매수" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="4" Height="30" IsEnabled="{Binding SelectedDraft.HasAvailableSelfUseSheets}" Text="{Binding SelectedDraft.SelfUseSheetQty, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Padding="8,5"
                                            Background="#FFF7ED"
                                            BorderBrush="#FDBA74"
                                            BorderThickness="1"
                                            Visibility="{Binding SelectedDraft.IsSelfUseSheetUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedDraft.SelfUseSheetAvailabilityGuide}" Foreground="#9A3412" />
                                    </Border>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="보관 위치" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedDraft.SelectedSelfUseSheet.LocationName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="위치재고" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding SelectedDraft.SelectedSelfUseSheet.CurrentQty, StringFormat={}{0:N0}매}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="원본 원자재 LOT" Foreground="#64748B" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="{Binding SelectedDraft.SelectedSelfUseSheet.SourceLotSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 생산 계산 -->
                            <Border Margin="0,8,0,0"
                                    Padding="10,8"
                                    Background="#F8FAFC"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="투입 매수" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Height="30" IsReadOnly="True" Background="#F5F5F5" Text="{Binding SelectedDraft.SheetQty, StringFormat={}{0:N0}}" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="총 컷수" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="4" Height="30" IsReadOnly="True" Background="#F5F5F5" Text="{Binding SelectedDraft.SheetCutCount, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="예상 생산수량" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="7" Height="30" IsReadOnly="True" Background="#F5F5F5" Text="{Binding SelectedDraft.ExpectedOutputQty, Mode=OneWay, StringFormat={}{0:N0}}" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="8" Margin="12,0,0,0" Text="묶음은 위 LOT별 컷수 합계를 자동 적용" Foreground="#6B7280" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 판데이터 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="판데이터 (묶음 필수)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" MinHeight="32" Padding="6" BorderBrush="#D0D7DE" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedDraft.PlateDataPath}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="3" Height="32" Content="판데이터 첨부" Command="{Binding UploadFileCommand}" />
                            </Grid>

                            <!-- 메모 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="메모" FontWeight="SemiBold" />
                                <TextBox Grid.Row="2"
                                         Height="58"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding SelectedDraft.Memo, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 단계별 고정 작업 막대 -->
        <Border Grid.Row="4"
                Padding="10,8"
                Background="#FFFFFF"
                BorderBrush="#D0D7DE"
                BorderThickness="1">
            <Grid>
                <Grid Visibility="{Binding IsCompositionStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="165" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CompositionStatusSummary}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Height="32" Content="초기화" Command="{Binding ResetCommand}" />
                    <Button Grid.Column="3" Height="32" Style="{StaticResource PrimaryButtonStyle}" Content="다음: 작업 상세 입력" Command="{Binding ShowDetailStepCommand}" />
                </Grid>

                <Grid Visibility="{Binding IsDetailStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DetailStatusSummary}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Height="32" Content="이전: LOT 구성" Command="{Binding ShowCompositionStepCommand}" />
                    <Button Grid.Column="3" Height="32" Content="초기화" Command="{Binding ResetCommand}" />
                    <Button Grid.Column="5" Height="32" Style="{StaticResource PrimaryButtonStyle}" Content="작업지시 저장" Command="{Binding SaveCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
