<Window x:Class="Mes.Wpf.Modules.Partners.Views.PartnerLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="거래처 검색"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="거래처명" />

                <TextBox Grid.Column="1"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="3"
                        Height="32"
                        Content="검색"
                        Command="{Binding SearchCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="거래처명" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="구분" Binding="{Binding PartnerType}" Width="120"/>
                    <DataGridTextColumn Header="사업자번호" Binding="{Binding BusinessNo}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="선택"
                    Click="SelectButton_Click" />
            <Button Width="100"
                    Height="32"
                    Content="닫기"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>