<UserControl x:Class="Mes.Wpf.Modules.Partners.Views.PartnerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Background="#F5F6FA">

   
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="1.4*"/>
            </Grid.RowDefinitions>

        <Border Grid.Row="0"
        Padding="16,12"
        Background="White"
        BorderBrush="#DDDDDD"
        BorderThickness="1"
        CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="검색어"
                   FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                 Height="30"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="3"
                   VerticalAlignment="Center"
                   Text="사용여부"
                   FontWeight="SemiBold"/>

                <ComboBox Grid.Column="4"
                  Height="30"
                  ItemsSource="{Binding UseYnOptions}"
                  SelectedItem="{Binding SelectedUseYn}" />

                <Button Grid.Column="6"
                Width="90"
                Height="30"
                HorizontalAlignment="Right"
                Content="조회"
                Command="{Binding SearchCommand}" />

                <Button Grid.Column="8"
                Width="90"
                Height="30"
                HorizontalAlignment="Right"
                Content="초기화"
                Command="{Binding ResetCommand}" />

                <Button Grid.Column="10"
                Width="90"
                Height="30"
                HorizontalAlignment="Right"
                Content="신규"
                Command="{Binding NewCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="거래처 목록"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <DataGrid Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Width="80"
                                                    Binding="{Binding PartnerId}" />
                                <DataGridTextColumn Header="구분"
                                                    Width="120"
                                                    Binding="{Binding PartnerType}" />
                                <DataGridTextColumn Header="거래처명"
                                                    Width="*"
                                                    Binding="{Binding Name}" />
                                <DataGridTextColumn Header="사업자번호"
                                                    Width="180"
                                                    Binding="{Binding BusinessNo}" />
                                <DataGridCheckBoxColumn Header="사용"
                                                        Width="80"
                                                        Binding="{Binding IsActive}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="16"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="거래처 편집"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="거래처구분"
                                   FontWeight="SemiBold"/>
                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Height="30"
                                  ItemsSource="{Binding PartnerTypeOptions}"
                                  SelectedItem="{Binding EditModel.PartnerType}" />

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="거래처명"
                                   FontWeight="SemiBold"/>
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding EditModel.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="사업자번호"
                                   FontWeight="SemiBold"/>
                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding EditModel.BusinessNo, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="사용여부"
                                   FontWeight="SemiBold"/>
                        <CheckBox Grid.Row="8"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding EditModel.IsActive}" />

                        <StackPanel Grid.Row="10"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Width="100"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Content="저장"
                                    Command="{Binding SaveCommand}" />
                            <Button Width="100"
                                    Height="32"
                                    Content="삭제"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Padding="16"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="320"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="벌크 업로드"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Height="30"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding BulkFilePath}" />       

                        <Button Grid.Column="2"
                                Height="30"
                                Content="파일 선택"
                                Command="{Binding SelectBulkFileCommand}" />        

                        <Button Grid.Column="4"
                                Height="30"
                                Content="업로드 실행"
                                Command="{Binding UploadBulkCommand}" />    

                        <Button Grid.Column="6"
                                Height="30"
                                Content="목록 비움"
                                Command="{Binding ClearBulkRowsCommand}" /> 
                    </Grid>

                    <DataGrid Grid.Row="4"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding BulkRows}"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="행"
                                                Width="70"
                                                Binding="{Binding RowNumber}" />
                            <DataGridTextColumn Header="구분"
                                                Width="120"
                                                Binding="{Binding PartnerType}" />
                            <DataGridTextColumn Header="거래처명"
                                                Width="*"
                                                Binding="{Binding Name}" />
                            <DataGridTextColumn Header="사업자번호"
                                                Width="180"
                                                Binding="{Binding BusinessNo}" />
                            <DataGridCheckBoxColumn Header="사용"
                                                    Width="80"
                                                    Binding="{Binding IsActive}" />
                            <DataGridCheckBoxColumn Header="유효"
                                                    Width="80"
                                                    Binding="{Binding IsValid}" />
                            <DataGridTextColumn Header="오류메시지"
                                                Width="260"
                                                Binding="{Binding ErrorMessage}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    
</UserControl>