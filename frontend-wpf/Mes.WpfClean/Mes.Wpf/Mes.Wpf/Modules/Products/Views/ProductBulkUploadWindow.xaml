<Window x:Class="Mes.Wpf.Modules.Products.Views.ProductBulkUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="품목 벌크 업로드"
        Width="1100"
        Height="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="품목 벌크 업로드" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Margin="0,0,8,0"
                     IsReadOnly="True"
                     Text="{Binding BulkFilePath}" />

            <Button Grid.Column="1"
                    Margin="0,0,8,0"
                    Content="템플릿 저장"
                    Command="{Binding DownloadTemplateCommand}" />

            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Content="파일 선택"
                    Command="{Binding SelectBulkFileCommand}" />

            <Button Grid.Column="3"
                    Margin="0,0,8,0"
                    Content="업로드"
                    Command="{Binding UploadBulkCommand}" />

            <Button Grid.Column="4"
                    Content="초기화"
                    Command="{Binding ClearBulkRowsCommand}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding BulkSummaryText}"
                       FontWeight="SemiBold" />

            <DataGrid Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding BulkRows}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="행" Binding="{Binding RowNumber}" Width="50" />
                    <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="110" />
                    <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="140" />
                    <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="70" />
                    <DataGridTextColumn Header="도면번호" Binding="{Binding DrawingNo}" Width="110" />
                    <DataGridTextColumn Header="라우팅코드" Binding="{Binding TemplateCode}" Width="110" />
                    <DataGridCheckBoxColumn Header="사용" Binding="{Binding IsActive}" Width="60" />
                    <DataGridCheckBoxColumn Header="유효" Binding="{Binding IsValid}" Width="60" />
                    <DataGridTextColumn Header="오류메시지" Binding="{Binding ErrorMessage}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>