<UserControl x:Class="Mes.Wpf.Modules.Products.Views.ProductPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 검색 영역 -->
        <Border Grid.Row="0"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="검색어" />

                <TextBox Grid.Column="1"
                         Margin="4,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="사용여부" />

                <ComboBox Grid.Column="3"
                          Margin="4,0"
                          ItemsSource="{Binding UseYnOptions}"
                          SelectedItem="{Binding SelectedUseYn}" />

                <Button Grid.Column="5"
                        Margin="8,0,0,0"
                        Content="조회"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="6"
                        Margin="8,0,0,0"
                        Content="초기화"
                        Command="{Binding ResetCommand}" />

                <Button Grid.Column="7"
                        Margin="8,0,0,0"
                        Content="신규"
                        Command="{Binding NewCommand}" />

                <Button Grid.Column="8"
                        Margin="8,0,0,0"
                        Content="벌크 업로드"
                        Click="BulkUpload_Click" />
            </Grid>
        </Border>

        <!-- 품목 목록 -->
        <Border Grid.Row="2"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="품목 목록" />

                <DataGrid Grid.Row="2"
                          MinHeight="320"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="100" />
                        <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="180" />
                        <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="70" />
                        <DataGridTextColumn Header="도면번호" Binding="{Binding DrawingNo}" Width="90" />
                        <DataGridTextColumn Header="라우팅ID" Binding="{Binding RoutingTemplateName}" Width="100" />
                        <DataGridTextColumn Header="Panel폭(mm)" Binding="{Binding PanelWidthMm}" Width="100" />
                        <DataGridTextColumn Header="Panel길이(mm)" Binding="{Binding PanelLengthMm}" Width="110" />
                        <DataGridTextColumn Header="제품사양" Binding="{Binding ProductSpec}" Width="150" />
                        <DataGridTextColumn Header="컷수" Binding="{Binding CutQtyPerPanel}" Width="80" />
                        <DataGridTextColumn Header="비고" Binding="{Binding Memo}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 품목 편집 -->
        <Border Grid.Row="4"
                Padding="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="품목 편집" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 좌측 영역 -->
                    <Grid Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="72" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="품목코드" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding EditModel.ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsCodeEditable}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="품목명" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding EditModel.ProductName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnlyMode}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="단위" />
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{Binding UomOptions}"
                                  SelectedItem="{Binding EditModel.Uom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnlyMode}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0" Text="도면검색" />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding DrawingSearchKeyword, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnlyMode}" />

                        <Border Grid.Row="8" Grid.Column="1"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Background="White">
                            <ListBox ItemsSource="{Binding DrawingOptions}"
                                     DisplayMemberPath="DrawingNo"
                                     SelectionChanged="DrawingSearchResult_SelectionChanged"
                                     IsEnabled="{Binding IsEditMode}"/>
                        </Border>

                        <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="도면번호" />

                        <Grid Grid.Row="10" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
             IsReadOnly="True"
             Text="{Binding SelectedDrawingNo}" />

                            <Button Grid.Column="2"
            Content="도면 보기"
            Command="{Binding ViewDrawingCommand}" />
                        </Grid>

                        <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" Text="라우팅명" />
                        <ComboBox Grid.Row="12" Grid.Column="1"
                                  ItemsSource="{Binding RoutingTemplateOptions}"
                                  SelectedValuePath="RoutingTemplateId"
                                  SelectedValue="{Binding EditModel.RoutingTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsEditMode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TemplateName}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Foreground="Gray"
                                                   Text="{Binding TemplateCode}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Text="사용여부" />
                        <ComboBox Grid.Row="14" Grid.Column="1"
                                  ItemsSource="{Binding UseYnOptions}"
                                  SelectedItem="{Binding EditModel.UseYn}" />
                    </Grid>

                    <!-- 우측 영역 -->
                    <Grid Grid.Column="3" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="72" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Panel 폭(mm)" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding EditModel.PanelWidthMm, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnlyMode}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Panel 길이(mm)" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding EditModel.PanelLengthMm, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="{Binding IsReadOnlyMode}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="제품사이즈" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding EditModel.ProductSpec, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="{Binding IsReadOnlyMode}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="컷수" 
/>
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Width="80"
                                 HorizontalAlignment="Left"
                                 Text="{Binding EditModel.CutQtyPerPanel, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="{Binding IsReadOnlyMode}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0" Text="비고" />
                        <TextBox Grid.Row="8" Grid.Column="1"
                                 Height="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding EditModel.Memo, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="{Binding IsReadOnlyMode}"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="수정"
                            Command="{Binding EditCommand}"
                            IsEnabled="{Binding CanEdit}" />    
                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="저장"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}" />
                    <Button Width="90"
                            Content="삭제"
                            Command="{Binding DeleteCommand}" />          
                </StackPanel>
            </Grid>
        </Border>

        <!-- 로딩 오버레이 -->
        <Border Grid.RowSpan="5"
                Background="#66000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                d:Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        Margin="20"
                        Width="260">
                <ProgressBar Height="16"
                             Margin="16,16,16,8"
                             IsIndeterminate="True" />
                <TextBlock Margin="16,0,16,16"
                           HorizontalAlignment="Center"
                           Text="{Binding LoadingMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>