<UserControl x:Class="Mes.Wpf.Modules.RawMaterials.Views.RawMaterialInventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="LOT 현재고">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="240"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"/>
                            <Button Width="80"
                                    Content="조회"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding InventoryLots}"
                              SelectedItem="{Binding SelectedInventoryLot}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="원자재코드" Binding="{Binding MaterialCode}" Width="120"/>
                            <DataGridTextColumn Header="원자재명" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="위치" Binding="{Binding LocationName}" Width="160"/>
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="140"/>
                            <DataGridTextColumn Header="현재고(M)" Binding="{Binding CurrentQty, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitCost, StringFormat={}{0:N4}}" Width="110"/>
                            <DataGridTextColumn Header="재고액" Binding="{Binding InventoryAmount, StringFormat={}{0:N0}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="입고 등록">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="입고 상세" FontSize="16" FontWeight="Bold"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="원자재" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Materials}"
                                          SelectedItem="{Binding SelectedInboundMaterial}"
                                          DisplayMemberPath="MaterialName"/>
                                <TextBlock Grid.Column="3" Text="입고위치" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding Locations}"
                                          SelectedItem="{Binding SelectedInboundLocation}"
                                          DisplayMemberPath="LocationName"/>
                                <TextBlock Grid.Column="6" Text="원단 LOT" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="7"
                                         Text="{Binding InboundLotNo, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="입고수량" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding InboundQty, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="3" Text="입고단가" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding InboundUnitCost, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="6" Text="메모" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="7"
                                         Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="100"
                                        Content="입고 저장"
                                        Command="{Binding InboundCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding InventoryLots}"
                              SelectedItem="{Binding SelectedInventoryLot}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="원자재명" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="위치" Binding="{Binding LocationName}" Width="160"/>
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="140"/>
                            <DataGridTextColumn Header="현재고(M)" Binding="{Binding CurrentQty, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitCost, StringFormat={}{0:N4}}" Width="110"/>
                            <DataGridTextColumn Header="재고액" Binding="{Binding InventoryAmount, StringFormat={}{0:N0}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="위치 이동">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding InventoryLots}"
                              SelectedItem="{Binding SelectedInventoryLot}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="원자재명" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="현재위치" Binding="{Binding LocationName}" Width="160"/>
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="140"/>
                            <DataGridTextColumn Header="현재고(M)" Binding="{Binding CurrentQty, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitCost, StringFormat={}{0:N4}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="이동대상 위치" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Locations}"
                                      SelectedItem="{Binding SelectedTransferToLocation}"
                                      DisplayMemberPath="LocationName"/>
                            <TextBlock Grid.Column="3" Text="이동수량" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding WorkQty, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="6" Text="메모" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="7"
                                     Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="9"
                                    Content="위치 이동"
                                    Command="{Binding TransferCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="재고 조정">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding InventoryLots}"
                              SelectedItem="{Binding SelectedInventoryLot}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="원자재명" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="위치" Binding="{Binding LocationName}" Width="160"/>
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="140"/>
                            <DataGridTextColumn Header="현재고(M)" Binding="{Binding CurrentQty, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitCost, StringFormat={}{0:N4}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="조정수량" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding WorkQty, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="3" Text="사유" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="6"
                                    Content="재고 증가"
                                    Command="{Binding AdjustInCommand}"/>
                            <Button Grid.Column="8"
                                    Content="재고 감소"
                                    Command="{Binding AdjustOutCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="수불 이력">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="원자재" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Materials}"
                                          SelectedItem="{Binding SelectedMovementMaterial}"
                                          DisplayMemberPath="MaterialName"/>
                                <TextBlock Grid.Column="3" Text="LOT" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding MovementLotNo, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="6" Text="위치" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="7"
                                          ItemsSource="{Binding Locations}"
                                          SelectedItem="{Binding SelectedMovementLocation}"
                                          DisplayMemberPath="LocationName"/>
                                <TextBlock Grid.Column="9" Text="유형" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="10"
                                          ItemsSource="{Binding MovementTypeOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Code"
                                          SelectedValue="{Binding SelectedMovementType}"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="시작일" VerticalAlignment="Center"/>
                                <DatePicker Grid.Column="1"
                                            SelectedDate="{Binding MovementDateFrom}"/>
                                <TextBlock Grid.Column="3" Text="종료일" VerticalAlignment="Center"/>
                                <DatePicker Grid.Column="4"
                                            SelectedDate="{Binding MovementDateTo}"/>
                                <Button Grid.Column="6"
                                        Content="조회"
                                        Command="{Binding RefreshMovementsCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Movements}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="일시" Binding="{Binding CreatedAt}" Width="180"/>
                            <DataGridTextColumn Header="구분" Binding="{Binding MovementTypeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="위치" Binding="{Binding LocationName}" Width="150"/>
                            <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="140"/>
                            <DataGridTextColumn Header="수량" Binding="{Binding Qty, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="반영 후 재고" Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="금액" Binding="{Binding AmountSnapshot, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="비고" Binding="{Binding Memo}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
