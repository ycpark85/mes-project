<UserControl x:Class="Mes.Wpf.Modules.RawMaterials.Views.RawMaterialInventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="240" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                <Button Width="80" Content="조회" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding InventoryLots}"
                  SelectedItem="{Binding SelectedInventoryLot}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="원자재코드" Binding="{Binding MaterialCode}" Width="120"/>
                <DataGridTextColumn Header="원자재명" Binding="{Binding MaterialName}" Width="*"/>
                <DataGridTextColumn Header="위치" Binding="{Binding LocationName}" Width="160"/>
                <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="140"/>
                <DataGridTextColumn Header="현재고(M)" Binding="{Binding CurrentQty, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTextColumn Header="단가" Binding="{Binding UnitCost, StringFormat={}{0:N4}}" Width="110"/>
                <DataGridTextColumn Header="재고액" Binding="{Binding InventoryAmount, StringFormat={}{0:N0}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Margin="0,12,0,12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="입고품목" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedInboundMaterial}" DisplayMemberPath="MaterialName"/>
                    <TextBlock Grid.Column="3" Text="입고위치" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedInboundLocation}" DisplayMemberPath="LocationName"/>
                    <TextBlock Grid.Column="6" Text="입고LOT" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="7" Text="{Binding InboundLotNo, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="9" Text="입고수량" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="10" Text="{Binding InboundQty, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="12" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="13" Content="입고" Command="{Binding InboundCommand}"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="이동대상위치" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedTransferToLocation}" DisplayMemberPath="LocationName"/>
                    <TextBlock Grid.Column="3" Text="처리수량" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Text="{Binding WorkQty, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="6" Text="입고단가" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="7" Text="{Binding InboundUnitCost, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="8" Text="{Binding SelectedInventoryLot.LotNo}" VerticalAlignment="Center" Margin="12,0"/>
                    <Button Grid.Column="9" Content="위치이동" Command="{Binding TransferCommand}"/>
                    <Button Grid.Column="11" Content="재고증가" Command="{Binding AdjustInCommand}"/>
                    <Button Grid.Column="13" Content="재고감소" Command="{Binding AdjustOutCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Movements}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="일시" Binding="{Binding CreatedAt}" Width="180"/>
                <DataGridTextColumn Header="구분" Binding="{Binding MovementType}" Width="130"/>
                <DataGridTextColumn Header="위치" Binding="{Binding LocationName}" Width="150"/>
                <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="140"/>
                <DataGridTextColumn Header="수량" Binding="{Binding Qty, StringFormat={}{0:N2}}" Width="100"/>
                <DataGridTextColumn Header="반영 후 재고" Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn Header="금액" Binding="{Binding AmountSnapshot, StringFormat={}{0:N0}}" Width="110"/>
                <DataGridTextColumn Header="비고" Binding="{Binding Memo}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
