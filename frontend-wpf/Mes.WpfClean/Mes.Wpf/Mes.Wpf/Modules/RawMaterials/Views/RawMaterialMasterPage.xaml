<UserControl x:Class="Mes.Wpf.Modules.RawMaterials.Views.RawMaterialMasterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="240"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0"/>
                <Button Width="80" Content="조회" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
                <Button Width="80" Content="초기화" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="원자재 품목">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코드" Binding="{Binding MaterialCode}" Width="120"/>
                            <DataGridTextColumn Header="원자재명" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="규격" Binding="{Binding MaterialSpec}" Width="120"/>
                            <DataGridTextColumn Header="폭(mm)" Binding="{Binding WidthMm}" Width="80"/>
                            <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="60"/>
                            <DataGridTextColumn Header="현재고" Binding="{Binding CurrentQty, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridCheckBoxColumn Header="사용" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="품목 상세" FontSize="16" FontWeight="Bold"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="코드" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding MaterialEditModel.MaterialCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsMaterialCodeEditable}"/>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="원자재명" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding MaterialEditModel.MaterialName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="규격" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding MaterialEditModel.MaterialSpec, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="폭(mm)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding MaterialEditModel.WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="3" Text="단위" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4" Text="{Binding MaterialEditModel.Uom, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="종류" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding MaterialEditModel.MaterialType, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="3" Text="표준단가" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4" Text="{Binding MaterialEditModel.StandardUnitCost, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="메모" VerticalAlignment="Top"/>
                                <TextBox Grid.Column="1" Height="70" AcceptsReturn="True" Text="{Binding MaterialEditModel.Memo, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="사용" IsChecked="{Binding MaterialEditModel.IsActive}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Width="90" Content="신규" Command="{Binding NewMaterialCommand}" Margin="0,0,8,0"/>
                                <Button Width="90" Content="저장" Command="{Binding SaveMaterialCommand}" Margin="0,0,8,0"/>
                                <Button Width="90" Content="삭제" Command="{Binding DeleteMaterialCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="원자재 위치">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding Locations}"
                              SelectedItem="{Binding SelectedLocation}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="위치코드" Binding="{Binding LocationCode}" Width="120"/>
                            <DataGridTextColumn Header="위치명" Binding="{Binding LocationName}" Width="*"/>
                            <DataGridTextColumn Header="유형" Binding="{Binding LocationType}" Width="150"/>
                            <DataGridTextColumn Header="거래처ID" Binding="{Binding PartnerId}" Width="90"/>
                            <DataGridTextColumn Header="현재고" Binding="{Binding CurrentQty, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridCheckBoxColumn Header="사용" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="위치 상세" FontSize="16" FontWeight="Bold"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="위치코드" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding LocationEditModel.LocationCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsLocationCodeEditable}"/>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="위치명" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding LocationEditModel.LocationName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="유형" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LocationTypeOptions}" SelectedItem="{Binding LocationEditModel.LocationType}"/>
                                <TextBlock Grid.Column="3" Text="거래처ID" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4" Text="{Binding LocationEditModel.PartnerId, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="메모" VerticalAlignment="Top"/>
                                <TextBox Grid.Column="1" Height="80" AcceptsReturn="True" Text="{Binding LocationEditModel.Memo, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="사용" IsChecked="{Binding LocationEditModel.IsActive}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Width="90" Content="신규" Command="{Binding NewLocationCommand}" Margin="0,0,8,0"/>
                                <Button Width="90" Content="저장" Command="{Binding SaveLocationCommand}" Margin="0,0,8,0"/>
                                <Button Width="90" Content="삭제" Command="{Binding DeleteLocationCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
