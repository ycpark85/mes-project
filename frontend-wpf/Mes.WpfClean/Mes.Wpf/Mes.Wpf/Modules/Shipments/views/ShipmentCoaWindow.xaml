<Window x:Class="Mes.Wpf.Modules.Shipments.Views.ShipmentCoaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COA"
        Width="900"
        Height="980"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="856*"/>
            <RowDefinition Height="53*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="검사일자"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"/>

                <DatePicker Grid.Column="1"
                            SelectedDate="{Binding Edit.InspectionDateSnapshot}"
                            Height="30"/>

                <TextBlock Grid.Column="2"
                           Text="수량"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="3"
                         Text="{Binding Edit.QuantitySnapshot, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         VerticalContentAlignment="Center"
                         TextAlignment="Right"/>

                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="저장"
                            Width="80"
                            Height="30"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="인쇄"
                            Width="80"
                            Height="30"
                            Margin="0,0,8,0"
                            Command="{Binding PrintCommand}"/>
                    <Button Content="닫기"
                            Width="80"
                            Height="30"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Grid.RowSpan="2">
            <Grid HorizontalAlignment="Center"
                  Margin="20">
                <Border x:Name="CoaPrintArea"
                        Width="760"
                        Height="1080"
                        Background="White"
                        BorderBrush="#111827"
                        BorderThickness="1"
                        Padding="34">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="56"/>
                            <RowDefinition Height="196"/>
                            <RowDefinition Height="500"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top">
                                <Border Width="46"
                                        Height="26"
                                        Background="#86A83E"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="세미산업"
                                               FontSize="22"
                                               Foreground="#86A83E"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Since 1995"
                                               FontSize="9"
                                               Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="인천광역시 서구 보도진로67(가좌동)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"/>
                                <TextBlock Text="TEL 032-572-6403   FAX 032-571-6425"
                                           FontSize="11"
                                           TextAlignment="Right"/>
                                <TextBlock Text="www.semindustry.co.kr"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="Black"
                                BorderThickness="2"
                                VerticalAlignment="Center"
                                Height="46">
                            <TextBlock Text="CERTIFICATE OF ANALYIS"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Times New Roman"
                                       FontStyle="Italic"
                                       FontWeight="Bold"
                                       FontSize="24"/>
                        </Border>

                        <Grid Grid.Row="2"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="제품명" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="규격" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductSpec}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="재질" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Material}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="업체명" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PartnerName}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="검사일자" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InspectionDateText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Lot No." FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LotNos}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="수량" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding QuantityText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>

                        <Grid Grid.Row="3"
                              Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="54"/>
                                <RowDefinition Height="54"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="0" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="0" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="0" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="0" Grid.Column="6" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="검사항목" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="검사기준" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="단위" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="측정 결과" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="판정" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="비고" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="1" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="1" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="1" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="1" Grid.Column="6" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="외관" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="이물, 홀, 찢김&#x0a;터짐 등이 없을 것" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding AppearanceResult}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding AppearanceJudgment}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>

                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="2" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="2" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="2" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="2" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="2" Grid.Column="6" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="외관" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="절단면이 Burr가 없이&#x0a;깨끗할 것" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding AppearanceResult}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding AppearanceJudgment}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>

                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="3" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="3" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="3" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="3" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="3" Grid.Column="6" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="인쇄상태" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="번짐이 없고&#x0a;깨끗할 것" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding PrintStateResult}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="5" Text="{Binding PrintStateJudgment}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>

                            <Border Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="5" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="5" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="5" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="5" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="4" Grid.RowSpan="2" Grid.Column="6" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" Text="치수" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="가로" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="세로" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding DimensionWidthCriteria}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding DimensionHeightCriteria}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="mm" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="3" Text="mm" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding DimensionWidthResult}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="4" Text="{Binding DimensionHeightResult}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="5" Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="5" Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>

                            <Border Grid.Row="6" Grid.RowSpan="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="7" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="8" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.RowSpan="3" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="7" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="8" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="7" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="8" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="7" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="8" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="6" Grid.RowSpan="3" Grid.Column="6" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="6" Grid.RowSpan="3" Grid.Column="0" Text="정량" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="좌" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="우" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="개봉부" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="6" Grid.RowSpan="3" Grid.Column="2" Text="00 ± 00" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="6" Grid.Column="3" Text="mm" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="7" Grid.Column="3" Text="mm" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="8" Grid.Column="3" Text="mm" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="6" Grid.Column="4" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="7" Grid.Column="4" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="8" Grid.Column="4" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="6" Grid.Column="5" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="7" Grid.Column="5" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="8" Grid.Column="5" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>

                            <Border Grid.Row="9" Grid.RowSpan="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="9" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="10" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="11" Grid.Column="1" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="9" Grid.RowSpan="3" Grid.Column="2" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="9" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="10" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="11" Grid.Column="3" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="9" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="10" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="11" Grid.Column="4" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="9" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="10" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="11" Grid.Column="5" BorderBrush="Black" BorderThickness="1"/>
                            <Border Grid.Row="9" Grid.RowSpan="3" Grid.Column="6" BorderBrush="Black" BorderThickness="1"/>

                            <TextBlock Grid.Row="9" Grid.RowSpan="3" Grid.Column="0" Text="접착강도" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="좌" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="우" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="개봉부" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="9" Grid.RowSpan="3" Grid.Column="2" Text="≥ 00" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="9" Grid.Column="3" Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="10" Grid.Column="3" Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="11" Grid.Column="3" Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="9" Grid.Column="4" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="10" Grid.Column="4" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="11" Grid.Column="4" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="9" Grid.Column="5" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="10" Grid.Column="5" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            <TextBlock Grid.Row="11" Grid.Column="5" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                        </Grid>

                        <StackPanel Grid.Row="4"
                                    Margin="0,22,0,0">
                            <TextBlock Text="위 의 내용이 사실이고 정확하다는 것을 증명 합니다."
                                       FontSize="13"
                                       FontWeight="Bold"
                                       FontStyle="Italic"/>
                            <TextBlock Text="{Binding PrintTypeText}"
                                       Margin="0,8,0,0"
                                       FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding IssueDateYear}" FontWeight="Bold"/>
                            <TextBlock Text=" 년     "/>
                            <TextBlock Text="{Binding IssueDateMonth}" FontWeight="Bold"/>
