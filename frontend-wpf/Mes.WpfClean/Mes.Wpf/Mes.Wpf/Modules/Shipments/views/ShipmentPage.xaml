<UserControl x:Class="Mes.Wpf.Modules.Shipments.Views.ShipmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">

    <UserControl.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 검색 / 탭 -->
        <Border Grid.Row="0" Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Content="출하대기"
                            Command="{Binding ShowWaitingCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWaitingTab}" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="출하완료"
                            Margin="8,0,0,0"
                            Command="{Binding ShowDoneCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDoneTab}" Value="True">
                                        <Setter Property="Background" Value="#059669"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#059669"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="검색어"/>

                    <TextBox Grid.Column="1"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="조회"
                            Command="{Binding SearchCommand}"/>

                    <Button Grid.Column="5"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="초기화"
                            Command="{Binding ResetCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 리스트 -->
        <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentTabTitle}"/>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   Text="{Binding SelectedCountText}"/>

                        <TextBlock Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   Text="{Binding PageInfoText}"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="White"
                          RowHeight="34"
                          ColumnHeaderHeight="38"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Visible">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="선택" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsWaitingTab, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="발주번호"
                                            Binding="{Binding OrderNo}"
                                            IsReadOnly="True"
                                            Width="110"
                                            ElementStyle="{StaticResource GridTextStyle}"/>

                        <DataGridTextColumn Header="거래처"
                                            Binding="{Binding PartnerName}"
                                            IsReadOnly="True"
                                            Width="150"
                                            ElementStyle="{StaticResource GridTextStyle}"/>

                        <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding ProductCode}"
                                            IsReadOnly="True"
                                            Width="130"
                                            ElementStyle="{StaticResource GridTextStyle}"/>

                        <DataGridTextColumn Header="품목명"
                                            Binding="{Binding ProductName}"
                                            IsReadOnly="True"
                                            Width="260"
                                            ElementStyle="{StaticResource GridTextStyle}"/>

                        <DataGridTextColumn Header="재고 LOT"
                                            Binding="{Binding StockLotNos}"
                                            Width="120"
                                            ElementStyle="{StaticResource GridTextStyle}"/>     

                        <DataGridTextColumn Header="생산 LOT"
                                            Binding="{Binding ProductionLotNos}"
                                            Width="120"
                                            ElementStyle="{StaticResource GridTextStyle}"/>     

                        <DataGridTextColumn Header="출하수량"
                                            Binding="{Binding ShipQty, StringFormat={}{0:N0}}"
                                            Width="100"
                                            ElementStyle="{StaticResource GridTextStyle}"/>     

                        <DataGridTextColumn Header="재고수량"
                                            Binding="{Binding StockShipQty, StringFormat={}{0:N0}}"
                                            Width="100"
                                            ElementStyle="{StaticResource GridTextStyle}"/> 

                        <DataGridTextColumn Header="생산수량"
                                            Binding="{Binding ProductionShipQty, StringFormat={}{0:N0}}"
                                            Width="100"
                                            ElementStyle="{StaticResource GridTextStyle}"/> 

                        <DataGridTextColumn Header="상태"
                                            Binding="{Binding StatusDisplay}"
                                            IsReadOnly="True"
                                            Width="90"
                                            ElementStyle="{StaticResource GridTextStyle}"/>

                        <DataGridTextColumn Header="출하일"
                                            Binding="{Binding ShippedDate, StringFormat=yyyy-MM-dd HH:mm}"
                                            IsReadOnly="True"
                                            Width="140"
                                            ElementStyle="{StaticResource GridTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 하단 액션 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Foreground="#6B7280"
                           FontWeight="SemiBold"
                           Text="{Binding TotalCountText}"/>

                <TextBlock Margin="16,0,0,0"
                           Foreground="#6B7280"
                           Text="{Binding PageInfoText}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="90"
                        Content="전체선택"
                        Command="{Binding SelectAllCommand}"
                        IsEnabled="{Binding IsWaitingTab}"/>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="90"
                        Margin="8,0,0,0"
                        Content="선택해제"
                        Command="{Binding ClearSelectionCommand}"/>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110"
                        Margin="8,0,0,0"
                        Content="선택출하"
                        Command="{Binding ConfirmSelectedCommand}"
                        IsEnabled="{Binding IsConfirmEnabled}"/>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="80"
                        Margin="20,0,0,0"
                        Content="이전"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPreviousPage}"/>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Content="다음"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNextPage}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>