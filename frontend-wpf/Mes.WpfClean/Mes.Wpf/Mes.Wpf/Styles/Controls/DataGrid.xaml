<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CrudDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="CrudDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="DataGridTextElementStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CrudDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DCEAFE" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EFF6FF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CrudDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.SurfaceAlt}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CrudDataGridColumnHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource CrudDataGridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource CrudDataGridRowStyle}" />
    </Style>

    <Style x:Key="DenseDataGridColumnHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource CrudDataGridColumnHeaderStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="DenseDataGridCellStyle"
           TargetType="DataGridCell"
           BasedOn="{StaticResource CrudDataGridCellStyle}">
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="DenseDataGridRowStyle"
           TargetType="DataGridRow"
           BasedOn="{StaticResource CrudDataGridRowStyle}">
        <Setter Property="Height" Value="36" />
    </Style>

    <Style x:Key="DenseDataGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource CrudDataGridStyle}">
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DenseDataGridColumnHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DenseDataGridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DenseDataGridRowStyle}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>

</ResourceDictionary>
