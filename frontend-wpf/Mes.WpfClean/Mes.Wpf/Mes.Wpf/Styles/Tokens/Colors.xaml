<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <Color x:Key="Color.Background">#FFF5F7FB</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFF8FAFC</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FF1F2937</Color>
    <Color x:Key="Color.TextSecondary">#FF6B7280</Color>
    <Color x:Key="Color.TextInverse">#FFFFFFFF</Color>

    <!-- Border -->
    <Color x:Key="Color.Border">#FFE5E7EB</Color>
    <Color x:Key="Color.BorderStrong">#FFD1D5DB</Color>

    <!-- Brand -->
    <Color x:Key="Color.Primary">#FF2563EB</Color>
    <Color x:Key="Color.PrimaryHover">#FF1D4ED8</Color>
    <Color x:Key="Color.PrimaryPressed">#FF1E40AF</Color>

    <!-- State -->
    <Color x:Key="Color.Success">#FF16A34A</Color>
    <Color x:Key="Color.Warning">#FFD97706</Color>
    <Color x:Key="Color.Danger">#FFDC2626</Color>

</ResourceDictionary>