<Window x:Class="Mes.Wpf.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:defectViews="clr-namespace:Mes.Wpf.Modules.DefectTypes.Views"
        xmlns:routingViews="clr-namespace:Mes.Wpf.Modules.RoutingTemplates.Views"
        Title="MES"
        Style="{StaticResource ShellWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource ShellSidebarStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MES"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />

                    <TextBlock Text="생산관리 시스템"
                               FontSize="13"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Margin="0,0,0,24" />

                    <Expander Header="메뉴"
                              IsExpanded="True"
                              Margin="0,0,0,12">
                        <StackPanel Margin="0,10,0,0">
                            <Button Content="대시보드"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="Dashboard_Click"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="기초등록 (마스터DB)"
                              IsExpanded="True"
                              Margin="0,0,0,12">
                        <StackPanel Margin="0,10,0,0">
                            <Button Content="거래처관리"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="Partner_Click"/> 
                            <Button Content="공정관리"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="Process_Click"/>

                            <Button Content="라우팅템플릿"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="RoutingTemplate_Click"/>
                            
                            <Button Content="라우팅템플릿스텝"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="RoutingTemplateStep_Click"/>

                            <Button Content="도면관리"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="Drawing_Click"/>             


                            <Button Content="불량유형"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,0,10"
                                    Click="DefectType_Click"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1.0 Frontend Base"
                           FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ShellHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle"
                                   Text="MES 프로그램"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="HeaderSubtitle"
                                   Text="프론트엔드 아키텍처 베이스"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="테스트 버튼"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl x:Name="MainContent" Visibility="Visible" />
            </Grid>
        </Grid>
    </Grid>
</Window>